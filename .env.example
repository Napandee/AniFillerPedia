# Copy to .env on the droplet — never commit the real .env (CLAUDE.md
# Guardrails: never commit secrets, env vars only).

# Postgres
POSTGRES_PASSWORD=

# Self-hosted GitHub Actions runner (docker-compose.yml `runner` service) —
# long-lived PAT, matching AniDex's anidex-runner pattern (see global
# ~/.claude/CLAUDE.md). Store the real value in Vaultwarden.
GITHUB_RUNNER_ACCESS_TOKEN=

# No GHCR_TOKEN needed here (removed 2026-08-21) — build-app.yml's deploy
# job authenticates to GHCR with the auto-provided, auto-scoped
# secrets.GITHUB_TOKEN, same as the build job. One less credential to
# manage or rotate on this file.

# Backend app config
DATABASE_URL=postgresql+asyncpg://anifillerpedia:${POSTGRES_PASSWORD}@postgres:5432/anifillerpedia
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
INITIAL_ADMIN_GITHUB_ID=
