# Copy to .env on the droplet — never commit the real .env (CLAUDE.md
# Guardrails: never commit secrets, env vars only).

# Postgres
POSTGRES_PASSWORD=

# Self-hosted GitHub Actions runner (docker-compose.yml `runner` service) —
# long-lived PAT, matching AniDex's anidex-runner pattern (see global
# ~/.claude/CLAUDE.md). Store the real value in Vaultwarden.
GITHUB_RUNNER_ACCESS_TOKEN=

# GHCR pull token used by build-app.yml's deploy job on the runner itself —
# NOT the same as GITHUB_RUNNER_ACCESS_TOKEN above. Referenced from
# ${{ vars.APPDATA_PATH }}/.env by the workflow, not read by docker-compose.
GHCR_TOKEN=

# Backend app config — placeholders, real shape depends on #6's actual
# settings module once it lands.
DATABASE_URL=postgresql://anifillerpedia:${POSTGRES_PASSWORD}@postgres:5432/anifillerpedia
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
INITIAL_ADMIN_GITHUB_ID=
