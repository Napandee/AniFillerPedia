# Secrets — never commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp
*~

# Claude Code — local context and machine-specific settings
.claude/settings.local.json
CLAUDE.local.md
# Private Claude context split out of CLAUDE.local.md. This repo is PUBLIC --
# anything under .claude/context/ is deliberately untracked. Do not un-ignore.
.claude/context
# no trailing slash on purpose: this path is a SYMLINK to the private
# claude-context repo, and git treats a symlink as a file, so a
# directory-only pattern ('.claude/context/') would not match it.
# Working scratch files -- never publish.
.claude/scratch/

# Data / volumes a compose file might create locally
*-data/
