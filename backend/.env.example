# Copy to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────────────────────────
# Async Postgres connection string — note the +asyncpg driver, not psycopg2
# (this project's stack is async SQLAlchemy throughout, unlike AniDex's sync
# psycopg2 setup).
DATABASE_URL=postgresql+asyncpg://anifillerpedia:changeme@localhost:5432/anifillerpedia

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
