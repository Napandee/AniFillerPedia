# Copy to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────────────────────────
# Async Postgres connection string — note the +asyncpg driver, not psycopg2
# (this project's stack is async SQLAlchemy throughout, unlike AniDex's sync
# psycopg2 setup).
DATABASE_URL=postgresql+asyncpg://anifillerpedia:changeme@localhost:5432/anifillerpedia

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Outbox consumers (#15) ───────────────────────────────────────────────────
# Both blank = handlers log a warning and skip, never crash the worker.
# See CLAUDE.local.md's external-account checklist for how to provision these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8528154154
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=090a6d6b91e55f92740f23bad2c11de6
PUBLIC_SITE_BASE_URL=https://anifillerpedia.wiki
