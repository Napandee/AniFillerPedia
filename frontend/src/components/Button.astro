---
interface Props {
  variant?: "primary" | "endorse" | "dispute" | "ghost";
  type?: "button" | "submit" | "reset";
  href?: string;
  // #80: a submit button's own name/value distinguishes which of several
  // buttons in one <form> triggered the POST (e.g. "Edit" vs "Confirm and
  // submit") — plain HTML form-submission behavior, not custom to this
  // component, but it needs forwarding or it's silently dropped.
  name?: string;
  value?: string;
  disabled?: boolean;
}

const { variant = "primary", type = "button", href, name, value, disabled } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class={`btn btn--${variant}`} {...(href ? { href } : { type, name, value, disabled })}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    border: none;
    text-decoration: none;
    cursor: pointer;
    line-height: 1.4;
  }
  .btn--primary {
    color: #fff;
    background: var(--color-accent);
  }
  /* #164: white text on raw --color-endorse (2.28:1, failing AA) switched to
     the same light-bg/dark-text "positive" pairing #143/#147 already
     established for the canon status badge (StatusBadge.astro,
     moderation.astro's .status-pill--canon) — --color-endorse itself stays
     untouched since it's still needed at full saturation for decorative
     dots/mini-bars elsewhere. Computed 6.49:1. */
  .btn--endorse {
    color: var(--color-status-canon-text);
    background: var(--color-status-canon-bg);
  }
  .btn--dispute {
    color: #fff;
    background: var(--color-dispute);
  }
  .btn--ghost {
    color: var(--color-text-muted);
    background: transparent;
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
