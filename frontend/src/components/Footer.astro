---
import { resolveLocale, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const year = new Date().getFullYear();
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<footer class="site-footer">
  <span>&copy; {year} AniFillerPedia</span>
  <nav>
    {/* #199: /contribute and /export-access were live but linked from
        nowhere in the site's own nav — added here (and to Header.astro's
        nav, for /contribute specifically). English-only pages, no locale
        wrapper (matches the docs/moderation precedent), so bare paths
        rather than getRelativeLocaleUrl — same reasoning as Header.astro's
        own needs-research/activity links. */}
    <a href="/contribute">{t("footer.contribute")}</a>
    <a href="/export-access">{t("footer.exportAccess")}</a>
    <a href={getRelativeLocaleUrl(locale, "/license")}>{t("footer.license")}</a>
    <a href={getRelativeLocaleUrl(locale, "/privacy")}>{t("footer.privacy")}</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 32px;
    border-top: 2px dashed var(--color-border-divider);
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--color-text-muted);
  }
  .site-footer nav {
    display: flex;
    gap: 16px;
  }
  .site-footer a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 700;
  }
</style>
