---
import { LOCALE_LABELS, SUPPORTED_LOCALES } from "../i18n/ui";
import { resolveLocale, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

// #37: identity/login state comes from Astro.locals.user (set by
// src/middleware.ts on every request via the real session cookie) — never
// held in client-only memory that would vanish or lie on refresh.
const user = Astro.locals.user;
const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";
const next = encodeURIComponent(Astro.url.pathname);

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// #106: strip any existing locale prefix off the current path before
// handing it to getRelativeLocaleUrl for each switcher link — Astro's own
// helper expects a locale-less path and re-prefixes it itself, so passing
// an already-prefixed path would double it up.
const pathWithoutLocale = (() => {
  for (const l of SUPPORTED_LOCALES) {
    const prefix = `/${l}`;
    if (Astro.url.pathname === prefix || Astro.url.pathname.startsWith(`${prefix}/`)) {
      return Astro.url.pathname.slice(prefix.length) || "/";
    }
  }
  return Astro.url.pathname;
})();

// Same-origin in the real deploy (Caddy fronts both under one domain), so a
// relative `next` correctly lands back on this app after the round trip.
// Cross-port local dev (Astro on :4321, backend on :8000) is a known
// exception — not fixed here, matches #37's own note that live end-to-end
// verification waits on real OAuth credentials anyway.
const authorizeHref = (provider: "github" | "discord") =>
  `${baseUrl}/api/v1/auth/${provider}/authorize?next=${next}`;
---

<header class="site-header">
  <a class="disp brand" href={getRelativeLocaleUrl(locale, "/")}>AniFillerPedia</a>
  <nav>
    <a href={getRelativeLocaleUrl(locale, "/")}>{t("nav.browse")}</a>
    {user && ["moderator", "admin", "owner"].includes(user.role) && (
      <a href={getRelativeLocaleUrl(locale, "/moderation")}>{t("nav.reviewQueue")}</a>
    )}
    {user && ["admin", "owner"].includes(user.role) && (
      <a href={getRelativeLocaleUrl(locale, "/admin/users")}>{t("nav.manageUsers")}</a>
    )}
    {
      user ? (
        <span class="identity">
          <a href={getRelativeLocaleUrl(locale, "/account")}>
            {user.display_name ?? t("nav.account")} <span class="role">· {user.role}</span>
          </a>
          <form method="POST" action="/api/logout" class="logout-form">
            <button type="submit" class="linklike">
              {t("nav.logOut")}
            </button>
          </form>
        </span>
      ) : (
        <span class="login-links">
          <a href={authorizeHref("github")}>{t("nav.logInGithub")}</a>
          <a href={authorizeHref("discord")}>{t("nav.logInDiscord")}</a>
        </span>
      )
    }
    <div class="lang-switcher">
      <button
        type="button"
        id="lang-switcher-trigger"
        class="lang-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="lang-switcher-menu"
      >
        <svg
          class="lang-trigger-globe"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
        </svg>
        {LOCALE_LABELS[locale]}
        <svg
          class="lang-trigger-chevron"
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div id="lang-switcher-menu" class="lang-menu" aria-label={t("lang.switcher.label")} hidden>
        {SUPPORTED_LOCALES.map((l) => (
          <a
            href={getRelativeLocaleUrl(l, pathWithoutLocale)}
            class:list={["lang-menu-item", { "lang-menu-item--active": l === locale }]}
            hreflang={l}
          >
            {LOCALE_LABELS[l]}
            {l === locale && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 12 10 18 20 6"></polyline>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // #106 (Direction A): globe-icon trigger opens a small anchored popover
  // with the 5 languages as pills — plain DOM APIs, matching this
  // project's existing convention for page-level interactivity (no
  // framework island for a widget this small).
  const trigger = document.getElementById("lang-switcher-trigger");
  const menu = document.getElementById("lang-switcher-menu");

  function closeMenu() {
    menu?.setAttribute("hidden", "");
    trigger?.setAttribute("aria-expanded", "false");
  }

  function openMenu() {
    menu?.removeAttribute("hidden");
    trigger?.setAttribute("aria-expanded", "true");
  }

  trigger?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (trigger.getAttribute("aria-expanded") === "true") {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Outside click and Escape both close it — the menu itself never
  // stops propagation, so a click on one of its own language links
  // reaches this handler too, but that's fine: the link's own
  // navigation already takes over immediately after.
  document.addEventListener("click", (event) => {
    if (menu && !menu.hidden && !menu.contains(event.target as Node) && event.target !== trigger) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-weight: 800;
    font-size: 19px;
    color: var(--color-accent);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
  }
  nav > a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .login-links,
  .identity {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .login-links a,
  .identity a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .lang-switcher {
    position: relative;
    padding-left: 12px;
    border-left: 2px solid var(--color-border-divider);
  }
  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px 7px 10px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-border-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 800;
    cursor: pointer;
  }
  .lang-trigger-globe {
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .lang-trigger-chevron {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  .lang-trigger[aria-expanded="true"] .lang-trigger-chevron {
    transform: rotate(180deg);
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 10;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--color-surface);
    border: 2px solid var(--color-border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sticker);
    padding: 8px;
  }
  .lang-menu[hidden] {
    display: none;
  }
  .lang-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 12px;
    color: var(--color-heading);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
  }
  .lang-menu-item:hover {
    background: var(--color-bg);
  }
  .lang-menu-item--active {
    background: var(--color-trust-chip-bg);
    color: var(--color-accent);
    font-weight: 800;
  }
  .role {
    color: var(--color-text-faint);
    font-weight: 600;
    text-transform: capitalize;
  }
  .logout-form {
    display: inline;
    margin: 0;
  }
  .linklike {
    font: inherit;
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
</style>
