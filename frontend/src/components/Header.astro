---
// #37: identity/login state comes from Astro.locals.user (set by
// src/middleware.ts on every request via the real session cookie) — never
// held in client-only memory that would vanish or lie on refresh.
const user = Astro.locals.user;
const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";
const next = encodeURIComponent(Astro.url.pathname);

// Same-origin in the real deploy (Caddy fronts both under one domain), so a
// relative `next` correctly lands back on this app after the round trip.
// Cross-port local dev (Astro on :4321, backend on :8000) is a known
// exception — not fixed here, matches #37's own note that live end-to-end
// verification waits on real OAuth credentials anyway.
const authorizeHref = (provider: "github" | "discord") =>
  `${baseUrl}/api/v1/auth/${provider}/authorize?next=${next}`;
---

<header class="site-header">
  <a class="disp brand" href="/">AniFillerPedia</a>
  <nav>
    <a href="/">Browse</a>
    {user && ["moderator", "admin", "owner"].includes(user.role) && <a href="/moderation">Review queue</a>}
    {user && ["admin", "owner"].includes(user.role) && <a href="/admin/users">Manage users</a>}
    {
      user ? (
        <span class="identity">
          <a href="/account">
            {user.display_name ?? "Account"} <span class="role">· {user.role}</span>
          </a>
          <form method="POST" action="/api/logout" class="logout-form">
            <button type="submit" class="linklike">
              Log out
            </button>
          </form>
        </span>
      ) : (
        <span class="login-links">
          <a href={authorizeHref("github")}>Log in with GitHub</a>
          <a href={authorizeHref("discord")}>Discord</a>
        </span>
      )
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-weight: 800;
    font-size: 19px;
    color: var(--color-accent);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
  }
  nav > a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .login-links,
  .identity {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .login-links a,
  .identity a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .role {
    color: var(--color-text-faint);
    font-weight: 600;
    text-transform: capitalize;
  }
  .logout-form {
    display: inline;
    margin: 0;
  }
  .linklike {
    font: inherit;
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
</style>
