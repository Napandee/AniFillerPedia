---
// #37: the account-linking control itself — #38's account page is where
// this actually gets placed, but the mechanism (GET /settings/link/{provider}
// is authenticated-only server-side, never reachable from the logged-out
// login flow) belongs here since it's the same auth-flow plumbing as login.
interface Props {
  provider: "github" | "discord";
  next?: string;
}

const { provider, next = "/account" } = Astro.props;
const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";
const href = `${baseUrl}/api/v1/settings/link/${provider}?next=${encodeURIComponent(next)}`;
const label = provider === "github" ? "GitHub" : "Discord";
---

<a class="link-provider" {href}>Link {label}</a>

<style>
  .link-provider {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
