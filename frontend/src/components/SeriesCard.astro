---
interface Props {
  title: string;
  episodeCount: number;
  href: string;
}

const { title, episodeCount, href } = Astro.props;
---

<a class="series-card" {href}>
  <div class="disp title">{title}</div>
  <div class="meta">{episodeCount} eps</div>
</a>

<style>
  .series-card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    box-shadow: var(--shadow-sticker);
    text-decoration: none;
    color: inherit;
  }
  .title {
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-heading);
  }
  .meta {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-text-faint);
    margin-top: 2px;
  }
</style>
