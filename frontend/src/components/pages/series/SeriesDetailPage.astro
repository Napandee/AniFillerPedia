---
// #33 (original scaffold) / #51 (this redesign): the series detail page —
// dashboard-style canon/filler/mixed overview, collapsible synonyms, and a
// decluttered episode list with per-row disclosure for citation/actions.
// Backed by GET /api/v1/series/{id} (header data) and
// GET /api/v1/series/{id}/episodes (the list itself, now including a
// nullable aired_at per #49/#51, a nullable title per #73, and citation.
// source_count per #74). Per CLAUDE.md, episode numbering is absolute and
// status is one of exactly three values (no `recap`).
//
// output: "server" means this route is resolved per-request — no
// getStaticPaths() needed.
//
// #116: this component is now given an already-resolved `resolution` prop
// rather than doing its own fetch — a real, verified Astro constraint
// (Astro.redirect()/Astro.response.status only take effect from the actual
// routed page component, not a nested one like this) means the redirect/404
// decision has to happen in each per-locale src/pages/.../[slug].astro
// wrapper, which calls src/lib/seriesDetail.ts's resolveSeriesDetail() and
// hands the result down. This component stays a pure rendering component,
// same responsibility split every other case in this file already has —
// data in, HTML out.
import Layout from "../../../layouts/Layout.astro";
import StatusBadge from "../../StatusBadge.astro";
import Button from "../../Button.astro";
import CoverFallback from "../../CoverFallback.astro";
import { resolveLocale, useTranslations } from "../../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { SeriesDetailResolution, EpisodeOut } from "../../../lib/seriesDetail";

interface Props {
  resolution: SeriesDetailResolution;
}

const { resolution } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// "redirect" should never actually reach this component in practice — the
// page wrapper redirects before rendering <SeriesDetailPage /> at all — but
// treating any non-"found" kind as not-found here is a harmless, cheap
// safety net rather than assuming that invariant always holds.
const notFound = resolution.kind !== "found";
const series = resolution.kind === "found" ? resolution.series : null;
const episodes = resolution.kind === "found" ? resolution.episodes : [];

// Everything below only runs once `series` is a real, resolved row —
// `seriesId` is its numeric id, used for the episodes fetch (done by the
// caller now) and every downstream link that's still numeric-id-based
// (episode submission/history routes — a separate route tree, untouched by
// #116).
const seriesId = series?.id ?? null;

// #51: full canon/filler/mixed breakdown for the dashboard cards, computed
// client-side from the fetched episode list — no dedicated backend field
// for this, same approach #33 originally used for the single "filler-free"
// stat this replaces.
const totalEpisodes = episodes.length;
const canonCount = episodes.filter((ep) => ep.status === "canon").length;
const fillerCount = episodes.filter((ep) => ep.status === "filler").length;
const mixedCount = episodes.filter((ep) => ep.status === "mixed").length;
const pct = (n: number) => (totalEpisodes > 0 ? Math.round((n / totalEpisodes) * 100) : 0);

// #94: range-notation summary — the literal filler-guide shorthand
// ("Canon: 1-44, 48-49...") grouped by status, computed from the same
// already-fetched episode list the stat cards above use (no new API
// surface). `episodes` is sorted by episode_number but may have GAPS
// (only researched episodes exist) — a gap always breaks a run, same as
// a status change, so e.g. episodes 1-5 then 7-10 canon (6 unresearched)
// renders as two separate ranges, never a false "1-10".
type EpisodeStatus = "canon" | "filler" | "mixed";
const STATUS_LABELS: Record<EpisodeStatus, string> = {
  canon: t("series.status.canon"),
  filler: t("series.status.filler"),
  mixed: t("series.status.mixed"),
};
const STATUS_ORDER: EpisodeStatus[] = ["canon", "filler", "mixed"];

function computeRangeGroups(eps: EpisodeOut[]): { status: EpisodeStatus; ranges: string[] }[] {
  const byStatus: Record<EpisodeStatus, string[]> = { canon: [], filler: [], mixed: [] };
  let curStatus: EpisodeStatus | null = null;
  let start = 0;
  let prev = 0;
  for (const ep of eps) {
    const n = ep.episode_number;
    const status = ep.status as EpisodeStatus;
    if (status !== curStatus || n !== prev + 1) {
      if (curStatus !== null) {
        byStatus[curStatus].push(start === prev ? `${start}` : `${start}–${prev}`);
      }
      curStatus = status;
      start = n;
    }
    prev = n;
  }
  if (curStatus !== null) {
    byStatus[curStatus].push(start === prev ? `${start}` : `${start}–${prev}`);
  }
  return STATUS_ORDER.map((status) => ({ status, ranges: byStatus[status] })).filter((g) => g.ranges.length > 0);
}

// First 10 ranges per status show inline; the rest sit behind a "+N more"
// <details> toggle so a heavily-fragmented show (e.g. Meitantei Conan:
// ~195 canon ranges alone) doesn't dump as a wall of numbers by default —
// verified against real data for both a moderately fragmented show
// (Naruto: Shippuuden, 85 runs) and a highly fragmented one (Conan, 390
// runs) during the #94 design pass before settling on this shape.
const RANGE_SUMMARY_VISIBLE_COUNT = 10;
const rangeGroups = computeRangeGroups(episodes);

// #55: the real total episode count (#49's AniList sync) is independent of
// how many episodes have actually been hand-researched — showing just
// "100 episodes tracked" implied that was the whole show. Null until #49's
// worker has synced this series at least once; falls back to the old
// wording rather than showing a misleading "100 of null".
const totalKnownEpisodes = series?.anilist_episode_count ?? null;

const pageTitle = series
  ? t("series.pageTitle.found", { title: series.title })
  : t("series.pageTitle.notFound");

// #46/#49: cover/banner art comes straight from our own API now — synced
// by the backend worker on a daily cadence, not fetched live from AniList
// on every page load (a real AniList outage previously took cover art down
// site-wide, since it used to be a synchronous per-request dependency).
// Null (never a broken image) whenever the sync hasn't reached this series
// yet, same as before.
const bannerUrl = series?.banner_image_url ?? series?.cover_image_url ?? null;

// #126: era tile — "1999 – present" / "1992 – 1993" — synced by #49's
// worker alongside everything else above. Null (no tile at all, not a
// placeholder) until the sync worker has reached this series and found a
// complete start date. start_date/end_date are ISO "YYYY-MM-DD" strings;
// slicing the first 4 chars avoids any Date()/timezone parsing entirely.
const startYear = series?.start_date ? series.start_date.slice(0, 4) : null;
const endYear = series?.end_date ? series.end_date.slice(0, 4) : null;
const eraLine =
  startYear === null
    ? null
    : endYear !== null
      ? t("series.era.range", { startYear, endYear })
      : series!.airing_status === "RELEASING"
        ? t("series.era.ongoing", { startYear })
        : // Edge case: no end date recorded, but AniList doesn't (or no
          // longer) reports this as RELEASING either (e.g. a
          // cancelled/hiatus show AniList never gave an end date for) —
          // an "ongoing"/"present" framing would be actively wrong here,
          // so fall back to just the bare start year.
          startYear;

// #126: about-card — AniList's own synopsis, cleaned server-side
// (services/anilist_sync.py's clean_anilist_description) into plain text
// with "\n\n" paragraph breaks. Null description (not yet synced, or this
// series genuinely has none) renders no card at all, same "nothing rather
// than a placeholder" convention as everywhere else on this page.
const descriptionParagraphs = series?.description
  ? series.description
      .split(/\n{2,}/)
      .map((p) => p.trim())
      .filter(Boolean)
  : [];
const firstParagraph = descriptionParagraphs[0] ?? null;
// Only a real second paragraph earns a "Read more" toggle — a single
// short paragraph with no natural break just renders plain, per #126's
// own acceptance criteria.
const restOfDescription =
  descriptionParagraphs.length > 1 ? descriptionParagraphs.slice(1).join("\n\n") : null;

// #51: aired_at is nullable (#49's AniList sync doesn't reach every
// episode — notably not the earlier episodes of an already-finished long
// show, since AniList's own schedule data only retains a rolling window).
// Render nothing at all for an episode with no synced date, rather than
// "Invalid Date" or a placeholder implying data that doesn't exist.
// #106: locale-aware date formatting — "en" keeps its original "en-US"
// formatting (no visual change for existing English visitors), the other
// four locales format the same real date in their own convention.
const DATE_FORMAT_LOCALE: Record<string, string> = { en: "en-US" };
const formatAiredAt = (iso: string | null) =>
  iso === null
    ? null
    : new Date(iso).toLocaleDateString(DATE_FORMAT_LOCALE[locale] ?? locale, {
        year: "numeric",
        month: "short",
        day: "numeric",
      });

// #63: a real, data-driven meta description — never generic boilerplate.
// Distinct copy for "nothing researched yet" vs. a series with real stats,
// since claiming a filler percentage with zero episodes tracked would be
// actively misleading.
const pageDescription =
  series &&
  (totalEpisodes > 0
    ? totalKnownEpisodes && totalKnownEpisodes > totalEpisodes
      ? t("series.pageDescription.withEpisodesOfTotal", {
          title: series.title,
          count: totalEpisodes,
          total: totalKnownEpisodes,
          pct: pct(canonCount),
        })
      : t("series.pageDescription.withEpisodes", {
          title: series.title,
          count: totalEpisodes,
          pct: pct(canonCount),
        })
    : t("series.pageDescription.empty", { title: series.title }));

// schema.org structured data — only when there's a real series to describe.
// numberOfEpisodes prefers the real AniList total over what's been
// hand-researched so far; sameAs links out to the AniList entry when known.
const structuredData = series
  ? {
      "@context": "https://schema.org",
      "@type": "TVSeries",
      name: series.title,
      // #116: the canonical URL for this series is now its slug, not its
      // numeric id — `series` is non-null in this branch, guaranteed by
      // the ternary above.
      url: new URL(`/series/${series.slug}`, Astro.site).toString(),
      ...(series.synonyms.length > 0 ? { alternateName: series.synonyms } : {}),
      ...(totalKnownEpisodes ? { numberOfEpisodes: totalKnownEpisodes } : {}),
      ...(series.anilist_id ? { sameAs: [`https://anilist.co/anime/${series.anilist_id}`] } : {}),
    }
  : undefined;
---

<Layout
  title={pageTitle}
  description={pageDescription || undefined}
  image={bannerUrl ?? undefined}
  noindex={notFound}
  structuredData={structuredData}
>
  {
    notFound ? (
      <section class="not-found">
        <div class="disp not-found-title">{t("series.notFound.title")}</div>
        <p>{t("series.notFound.body")}</p>
        <Button href={getRelativeLocaleUrl(locale, "/")} variant="ghost">
          {t("series.notFound.back")}
        </Button>
      </section>
    ) : (
      <>
        <section class="series-header">
          <div class:list={["banner", { "banner--photo": !!bannerUrl }]}>
            {bannerUrl ? (
              <>
                <div class="banner-img" style={`background-image:url(${bannerUrl})`} />
                <div class="banner-scrim" />
              </>
            ) : (
              <CoverFallback title={series!.title} fontSize="56px" />
            )}
          </div>
          <div class="hero-row">
            <div class="thumb">
              {series!.cover_image_url ? (
                <img src={series!.cover_image_url} alt="" loading="lazy" />
              ) : (
                <CoverFallback title={series!.title} fontSize="28px" />
              )}
            </div>
            <div class="title-block">
              <div class="disp title">
                {series!.title}
                {series!.airing_status === "RELEASING" && <span class="airing-badge">{t("series.airingBadge")}</span>}
              </div>
            </div>
            {eraLine !== null && (
              <div class="era-tile">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18" /><path d="M8 3v4" /><path d="M16 3v4" /></svg>
                {eraLine}
              </div>
            )}
          </div>

          {firstParagraph !== null && (
            <div class="about-card">
              <div class="about-label">{t("series.about.label")}</div>
              <div class="about-text">
                {firstParagraph}
                {restOfDescription !== null && (
                  <details class="about-more">
                    <summary><span class="about-more-label">{t("series.about.readMore")}</span></summary>
                    <span class="about-more-text">{restOfDescription}</span>
                  </details>
                )}
              </div>
            </div>
          )}

          {series!.synonyms.length > 0 && (
            <details class="synonyms">
              <summary>{t("series.alsoKnownAs", { count: series!.synonyms.length })}</summary>
              <p class="synonyms-list">{series!.synonyms.join(", ")}</p>
            </details>
          )}

          {series!.related_series.length > 0 && (
            <div class="related-series">
              <span class="related-series-label">{t("series.alsoOnThisSite")}</span>
              {series!.related_series.map((related) => (
                <a class="related-series-link" href={getRelativeLocaleUrl(locale, `/series/${related.slug}`)}>
                  {related.title}
                </a>
              ))}
            </div>
          )}

          {/* #133: watch-order navigation — a stronger call-to-action than
              the plain "Also on this site" pill list above ("go watch the
              next/previous entry"), so it's visually distinct rather than
              blended into that list. Renders nothing when the current
              series has no sequence_order or no adjacent related entry
              with one, matching this page's existing no-placeholder
              convention (see #51). */}
          {(series!.previous_series || series!.next_series) && (
            <div class="watch-nav">
              {series!.previous_series && (
                <a
                  class="watch-nav-link watch-nav-link--prev"
                  href={getRelativeLocaleUrl(locale, `/series/${series!.previous_series.slug}`)}
                >
                  <span class="watch-nav-arrow">←</span>
                  <span class="watch-nav-text">
                    <span class="watch-nav-kicker">{t("series.watchPrevious")}</span>
                    <span class="watch-nav-title">{series!.previous_series.title}</span>
                  </span>
                </a>
              )}
              {series!.next_series && (
                <a
                  class="watch-nav-link watch-nav-link--next"
                  href={getRelativeLocaleUrl(locale, `/series/${series!.next_series.slug}`)}
                >
                  <span class="watch-nav-text">
                    <span class="watch-nav-kicker">{t("series.watchNext")}</span>
                    <span class="watch-nav-title">{series!.next_series.title}</span>
                  </span>
                  <span class="watch-nav-arrow">→</span>
                </a>
              )}
            </div>
          )}

          {totalEpisodes > 0 && (
            <div class="stat-cards" id="stat-cards">
              <button class="stat-card" data-status="canon" data-count={canonCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--canon">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                  </span>
                  <span class="stat-name">{STATUS_LABELS.canon}</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{canonCount}</div>
                <div class="stat-pct">{t("series.pctOfTracked", { pct: pct(canonCount) })}</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--canon" style={`width:${pct(canonCount)}%`} /></div>
              </button>

              <button class="stat-card" data-status="filler" data-count={fillerCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--filler">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><polygon points="13 2 4 14 11 14 10 22 20 9 13 9 13 2" /></svg>
                  </span>
                  <span class="stat-name">{STATUS_LABELS.filler}</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{fillerCount}</div>
                <div class="stat-pct">{t("series.pctOfTracked", { pct: pct(fillerCount) })}</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--filler" style={`width:${pct(fillerCount)}%`} /></div>
              </button>

              <button class="stat-card" data-status="mixed" data-count={mixedCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--mixed">
                    <svg width="13" height="13" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" /></svg>
                  </span>
                  <span class="stat-name">{STATUS_LABELS.mixed}</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{mixedCount}</div>
                <div class="stat-pct">{t("series.pctOfTracked", { pct: pct(mixedCount) })}</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--mixed" style={`width:${pct(mixedCount)}%`} /></div>
              </button>
            </div>
          )}

          <div class="stat-row">
            <span class="stat-chip">
              {totalKnownEpisodes !== null && totalKnownEpisodes > totalEpisodes
                ? t("series.episodesTrackedOf", { count: totalEpisodes, total: totalKnownEpisodes })
                : t(totalEpisodes === 1 ? "series.episodesTracked_one" : "series.episodesTracked_other", {
                    count: totalEpisodes,
                  })}
            </span>
          </div>

          {/* #94: the literal range-notation summary, grouped by status —
              a complementary detail view under the stat cards above, not a
              replacement for them. */}
          {rangeGroups.length > 0 && (
            <div class="range-summary" id="range-summary">
              {rangeGroups.map((group) => {
                const visible = group.ranges.slice(0, RANGE_SUMMARY_VISIBLE_COUNT);
                const remainder = group.ranges.slice(RANGE_SUMMARY_VISIBLE_COUNT);
                return (
                  <div class="range-group" data-status={group.status}>
                    <span class={`range-label range-label--${group.status}`}>
                      <span class="range-dot" />
                      {STATUS_LABELS[group.status]}
                    </span>
                    <span class="range-text">
                      {visible.join(", ")}
                      {remainder.length > 0 && (
                        <details class="range-more">
                          <summary><span class="range-more-count">+{remainder.length} more</span></summary>
                          <span class="range-more-text">{remainder.join(", ")}</span>
                        </details>
                      )}
                    </span>
                  </div>
                );
              })}
            </div>
          )}

          {totalEpisodes > 0 && (
            <div class="filter-chip-row" id="filter-chip-row" hidden>
              <span class="filter-chip">
                {t("series.filterChip.showing")} <span id="filter-chip-label">{STATUS_LABELS.filler}</span>{" "}
                {t("series.filterChip.episodesOnly")} (<span id="filter-chip-count">0</span>)
                <button type="button" id="filter-clear">{t("series.filterChip.clear")}</button>
              </span>
            </div>
          )}
        </section>

        <section class="episode-list">
          {episodes.length === 0 ? (
            <div class="empty-state">
              <p class="disp empty-title">{t("series.empty.title")}</p>
              <p>{t("series.empty.body")}</p>
              <Button href={getRelativeLocaleUrl(locale, `/series/${seriesId}/episodes/1/submit`)} variant="primary">
                {t("series.empty.submitFirst")}
              </Button>
            </div>
          ) : (
            episodes.map((episode) => {
              const airedAt = formatAiredAt(episode.aired_at ?? null);
              const lastVerified = formatAiredAt(episode.updated_at);
              return (
                <details class="episode-row" data-status={episode.status}>
                  <summary class="episode-row-head">
                    <span class="episode-number">{t("series.episodeAbbrev", { number: episode.episode_number })}</span>
                    {/* #73: reopens #33's "skip for v1" call — empty when
                        untitled (most episodes, for a long time), same
                        stable-grid-column convention #55 established for
                        air-date below. */}
                    <span class="episode-title-inline">{episode.title}</span>
                    <StatusBadge status={episode.status as "canon" | "filler" | "mixed"} />
                    {/* #87: distinct from the status badge above — a visibility
                        affordance for browsing, not a fourth status value.
                        Same #55 stable-grid-column convention as air-date
                        below: always rendered, an empty (unstyled) span when
                        false so the chevron's column never shifts. Stops the
                        click from also bubbling into the summary's own
                        toggle (wired in the script below) since this is a
                        real link, not just row-expand affordance. */}
                    {episode.has_pending_contribution ? (
                      <a
                        class="pending-indicator"
                        href={getRelativeLocaleUrl(locale, `/episodes/${episode.id}/history`)}
                        title={t("series.pendingIndicator.title")}
                      >
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10" /></svg>
                        {t("series.pendingIndicator.label")}
                      </a>
                    ) : (
                      <span class="pending-indicator" />
                    )}
                    {/* #55: always rendered, even when empty — omitting this
                        span entirely when aired_at is unknown left only 3
                        grid children for a 4-column grid, so the chevron
                        landed in the 3rd (1fr) column instead of the last
                        one, right next to the badge instead of the far
                        right edge. An empty cell keeps the column count
                        stable without showing placeholder text. */}
                    <span class="air-date">{airedAt}</span>
                    <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                  </summary>
                  <div class="episode-detail">
                    {episode.citation.url ? (
                      <a class="citation-text" href={episode.citation.url} target="_blank" rel="noopener noreferrer">
                        {episode.citation.description}
                      </a>
                    ) : (
                      <p class="citation-text">{episode.citation.description}</p>
                    )}
                    {/* #77: the full research trail, split out of the short
                        description above — omitted entirely when there's
                        nothing more to say than that. */}
                    {episode.citation.methodology_note && (
                      <details class="methodology">
                        <summary>{t("series.howVerified")}</summary>
                        <p class="methodology-note">{episode.citation.methodology_note}</p>
                      </details>
                    )}
                    {/* #74: omitted entirely at the default of 1 — a single-
                        source citation isn't a corroboration claim, don't
                        imply one. */}
                    {episode.citation.source_count > 1 && (
                      <div class="trust-badge">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><polyline points="9 12 11 14 15 10" /></svg>
                        {t("series.sourcesAgree", { count: episode.citation.source_count })}
                      </div>
                    )}
                    {episode.status_note && <p class="status-note">{episode.status_note}</p>}
                    <p class="verified-line">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                      {t("series.lastVerified", { date: lastVerified ?? "" })}
                    </p>
                    <div class="detail-actions">
                      <Button href={getRelativeLocaleUrl(locale, `/episodes/${episode.id}/history`)} variant="ghost">
                        {t("series.historyAndVotes")}
                      </Button>
                      <Button
                        href={getRelativeLocaleUrl(
                          locale,
                          `/series/${seriesId}/episodes/${episode.episode_number}/submit`
                        )}
                        variant="primary"
                      >
                        {t("series.submitCorrection")}
                      </Button>
                    </div>
                  </div>
                </details>
              );
            })
          )}
        </section>

        <script>
          // #51: click a stat card to filter the episode list to that
          // status only; click the same card again (or "clear") to reset.
          // Purely client-side — every episode is already in the fetched
          // page, so this never issues a new request.
          const cardsContainer = document.getElementById("stat-cards");
          const chipRow = document.getElementById("filter-chip-row");
          const chipLabel = document.getElementById("filter-chip-label");
          const chipCount = document.getElementById("filter-chip-count");
          const clearButton = document.getElementById("filter-clear");
          const rangeSummary = document.getElementById("range-summary");
          const rows = Array.from(document.querySelectorAll<HTMLElement>(".episode-row"));

          // #100: which status's range-summary "+N more" this code opened,
          // if any — so deselecting closes only that one back down, never
          // a different status's group a visitor opened by hand themselves
          // (known/accepted edge case: if a visitor manually opens a
          // group's own "+N more" and THEN selects, then deselects, that
          // same card, this will close it too — selecting a card always
          // forces its own group open, deselecting always forces it shut).
          let autoOpenedStatus: string | null = null;

          function applyFilter(status: string | null) {
            for (const row of rows) {
              row.hidden = status !== null && row.dataset.status !== status;
            }
            for (const card of cardsContainer?.querySelectorAll<HTMLElement>(".stat-card") ?? []) {
              card.classList.toggle("is-active", card.dataset.status === status);
            }
            if (status === null) {
              chipRow?.setAttribute("hidden", "");
            } else {
              chipRow?.removeAttribute("hidden");
              const activeCard = cardsContainer?.querySelector<HTMLElement>(`.stat-card[data-status="${status}"]`);
              // #106: read the already-translated label off the stat card
              // itself (rendered server-side via t()) rather than the raw
              // English status string, so the filter chip stays in the
              // page's own language.
              if (chipLabel) {
                chipLabel.textContent = activeCard?.querySelector(".stat-name")?.textContent ?? status;
              }
              if (chipCount) chipCount.textContent = activeCard?.dataset.count ?? "0";
            }

            if (autoOpenedStatus !== null) {
              const previous = rangeSummary?.querySelector<HTMLDetailsElement>(
                `.range-group[data-status="${autoOpenedStatus}"] details.range-more`
              );
              if (previous) previous.open = false;
            }
            if (status !== null) {
              const current = rangeSummary?.querySelector<HTMLDetailsElement>(
                `.range-group[data-status="${status}"] details.range-more`
              );
              if (current) current.open = true;
            }
            autoOpenedStatus = status;
          }

          cardsContainer?.addEventListener("click", (event) => {
            const card = (event.target as HTMLElement).closest<HTMLElement>(".stat-card");
            if (!card) return;
            const isActive = card.classList.contains("is-active");
            applyFilter(isActive ? null : card.dataset.status ?? null);
          });

          clearButton?.addEventListener("click", () => applyFilter(null));

          // #87: the pending-indicator link lives inside <summary>, so a
          // click on it would otherwise also toggle the parent <details>
          // (the row's own expand/collapse) in addition to navigating —
          // harmless once navigation unloads the page, but stopping it
          // avoids a visible flicker first.
          for (const link of document.querySelectorAll<HTMLAnchorElement>("a.pending-indicator")) {
            link.addEventListener("click", (event) => event.stopPropagation());
          }
        </script>
      </>
    )
  }
</Layout>

