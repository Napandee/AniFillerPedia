---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";

// #63: SEO basics. description/image are per-page and data-driven (a series
// page builds its own from real episode counts, never generic boilerplate)
// — DEFAULT_DESCRIPTION only covers pages that don't have anything more
// specific to say. noindex is for auth-gated/thin pages (account, admin,
// moderation, the submission forms) that shouldn't show up in search
// results at all, on top of robots.txt's crawl-budget Disallow for the
// same paths. structuredData is an optional schema.org object, stringified
// as JSON-LD — only series pages use this today.
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const DEFAULT_DESCRIPTION =
  "AniFillerPedia is an open, community-editable database of anime filler and canon episodes — find out which episodes you can skip, and which you can't.";

const { title, description = DEFAULT_DESCRIPTION, image, noindex = false, structuredData } = Astro.props;

// Security review (#89): structuredData's own fields (series.title,
// synonyms) are reachable from the public series-proposal form
// (services/series_proposals.py, no sanitization there or anywhere else
// in that path) all the way to this JSON-LD script tag. JSON.stringify
// alone does NOT escape "</script>", so a series titled
// `Foo</script><script>...` would break out of this tag and execute on
// every visitor of that series page. <-escaping every "<" is valid
// inside a JSON string (doesn't change what JSON.parse produces) and
// makes that breakout impossible — the standard safe pattern for
// injecting JSON into an inline <script> tag.
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;

// Astro.site comes from astro.config.mjs's `site` — the one place the real
// production origin is written down.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AniFillerPedia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {structuredDataJson && <script type="application/ld+json" is:inline set:html={structuredDataJson} />}
  </head>
  <body>
    <div class="shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
  }
  .disp {
    font-family: var(--font-display);
  }
</style>

<style>
  .shell {
    max-width: 880px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    padding: 24px 32px 8px;
  }
</style>
