---
// #38: "My account" — a logged-in user's own contributions, series
// proposals, and votes cast, plus account settings (linked providers,
// delete account). Out of scope: any moderation-facing view of OTHER
// users' activity (see #39 for that) — every fetch below is scoped to
// `/mine` endpoints that are inherently caller-only server-side.
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import StatusBadge from "../components/StatusBadge.astro";
import type { EpisodeStatus } from "../components/StatusBadge.astro";
import LinkProviderButton from "../components/LinkProviderButton.astro";
import { createApiClient } from "../api/client";

// Redirect to login rather than rendering a 401 error page — must happen
// before any data fetching below.
//
// #200: preserve where the visitor was headed (`next`) and why they were
// bounced (`notice`) — a bare Astro.redirect("/") previously dropped both,
// so a visitor whose session expired had no explanation and had to
// manually re-navigate back to /account after logging back in.
// HomePage.astro reads `notice` to show a one-line banner; Header.astro
// reads `next` (in preference to the homepage's own pathname) to build its
// login links, so a successful login lands back here.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    `/?next=${encodeURIComponent(Astro.url.pathname)}&notice=login_required`
  );
}

const cookie = Astro.request.headers.get("cookie") ?? "";
const api = createApiClient(import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000");

const [contributionsRes, proposalsRes, votesRes] = await Promise.all([
  api.GET("/api/v1/contributions/mine", { headers: { cookie } }),
  api.GET("/api/v1/series-proposals/mine", { headers: { cookie } }),
  api.GET("/api/v1/contributions/mine/votes", { headers: { cookie } }),
]);

// #196: GET /contributions/mine and GET /contributions/mine/votes now
// return a {items, total, limit, offset} pagination envelope instead of a
// bare array — read `.items` for the first page and keep `total` around
// so a "Load more" control knows when more pages exist. series-proposals/
// mine is a DIFFERENT endpoint, explicitly out of this issue's scope —
// left exactly as-is (still a bare array).
const myContributions = contributionsRes.data?.items ?? [];
const myContributionsTotal = contributionsRes.data?.total ?? myContributions.length;
const myProposals = proposalsRes.data ?? [];
const myVotes = votesRes.data?.items ?? [];
const myVotesTotal = votesRes.data?.total ?? myVotes.length;

const dateFmt = (iso: string) =>
  new Date(iso).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });

const resolutionLabel = (method: string | null) => {
  if (method === "moderator") return "moderator approval";
  if (method === "community_vote") return "community vote";
  return null;
};
---

<Layout title="My Account — AniFillerPedia" noindex>
  <section class="account-head">
    <div>
      {/* #197: real heading element — element change only, ".headline" is
          a class selector so the existing styling is unchanged. */}
      <h1 class="disp headline">Hey, {user.display_name ?? "there"}</h1>
      <div class="sub">
        <span class="role-chip">{user.role}</span>
        <span class="trust-chip">Trust score: {user.trust_score}</span>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="disp panel-title">Account settings</div>

    <div class="settings-block">
      <div class="settings-label">Linked sign-in providers</div>
      <p class="settings-note">
        Link another provider to sign in with either one. Linking a provider
        already attached to your account is safely rejected by the server.
      </p>
      <div class="provider-row">
        <LinkProviderButton provider="github" next="/account" />
        <LinkProviderButton provider="discord" next="/account" />
      </div>
    </div>

    <div class="settings-block danger">
      <div class="settings-label">Delete account</div>
      <p class="settings-note">
        Deleting your account removes your personal data (email, display
        name, avatar, linked sign-in identifiers) immediately. Your past
        contributions and votes are preserved but anonymized — they remain
        part of the public record and audit trail, but are no longer linked
        to your identity. This action cannot be undone.
      </p>
      <form method="POST" action="/api/delete-account" id="delete-account-form">
        <label class="confirm-row">
          <input type="checkbox" name="confirm" required />
          I understand this permanently deletes my account and cannot be undone.
        </label>
        <Button type="submit" variant="dispute">Delete my account</Button>
      </form>
    </div>
  </section>

  <section class="panel">
    <div class="disp panel-title">My contributions</div>
    {
      myContributions.length === 0 ? (
        <p class="empty">You haven't submitted any episode corrections yet.</p>
      ) : (
        <ul class="item-list" id="my-contributions-list">
          {myContributions.map((c) => (
            <li class="item-card">
              <div class="item-top">
                <StatusBadge status={c.proposed_status as EpisodeStatus} />
                <span class="item-target">Series #{c.series_id} · Episode {c.episode_number}</span>
              </div>
              {c.proposed_note && <p class="item-note">{c.proposed_note}</p>}
              <p class="item-citation">
                Citation:{" "}
                {c.citation.url ? (
                  <a href={c.citation.url} target="_blank" rel="noopener noreferrer">
                    {c.citation.description}
                  </a>
                ) : (
                  c.citation.description
                )}
              </p>
              <div class="item-meta">
                <span class={`status-chip status-chip--${c.review_status}`}>{c.review_status}</span>
                {resolutionLabel(c.resolution_method) && (
                  <span class="meta-note">via {resolutionLabel(c.resolution_method)}</span>
                )}
                <span class="meta-note">submitted {dateFmt(c.submitted_at)}</span>
              </div>
              {c.review_note && <p class="review-note">Reviewer note: {c.review_note}</p>}
            </li>
          ))}
        </ul>
      )
    }
    {myContributions.length < myContributionsTotal && (
      <button
        type="button"
        class="btn-load-more"
        id="contributions-load-more"
        data-offset={myContributions.length}
        data-total={myContributionsTotal}
      >
        Load more ({myContributions.length} of {myContributionsTotal})
      </button>
    )}
  </section>

  <section class="panel">
    <div class="disp panel-title">My series proposals</div>
    {
      myProposals.length === 0 ? (
        <p class="empty">You haven't proposed any new series yet.</p>
      ) : (
        <ul class="item-list">
          {myProposals.map((p) => (
            <li class="item-card">
              <div class="item-top">
                <span class="item-target disp">{p.title}</span>
              </div>
              <p class="item-note">{p.justification}</p>
              <div class="item-meta">
                <span class={`status-chip status-chip--${p.review_status}`}>{p.review_status}</span>
                <span class="meta-note">submitted {dateFmt(p.submitted_at)}</span>
              </div>
              {p.review_note && <p class="review-note">Reviewer note: {p.review_note}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="panel">
    <div class="disp panel-title">My votes</div>
    {
      myVotes.length === 0 ? (
        <p class="empty">You haven't endorsed or disputed any contributions yet.</p>
      ) : (
        <ul class="item-list" id="my-votes-list">
          {myVotes.map((v) => (
            <li class="item-card">
              <div class="item-top">
                <span class={`vote-chip vote-chip--${v.vote}`}>{v.vote}</span>
                <StatusBadge status={v.proposed_status as EpisodeStatus} />
                <span class="item-target">{v.series_title} · Episode {v.episode_number}</span>
              </div>
              <div class="item-meta">
                <span class={`status-chip status-chip--${v.review_status}`}>{v.review_status}</span>
                {resolutionLabel(v.resolution_method) && (
                  <span class="meta-note">via {resolutionLabel(v.resolution_method)}</span>
                )}
                <span class="meta-note">weight at vote: {v.weight_at_vote}</span>
                <span class="meta-note">cast {dateFmt(v.created_at)}</span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    {myVotes.length < myVotesTotal && (
      <button
        type="button"
        class="btn-load-more"
        id="votes-load-more"
        data-offset={myVotes.length}
        data-total={myVotesTotal}
      >
        Load more ({myVotes.length} of {myVotesTotal})
      </button>
    )}
  </section>
</Layout>

<script>
  // #196 review follow-up: the fetch/offset/button-label state machine for
  // both "Load more" buttons below is shared with admin/moderation.astro's
  // own "Load more" via ../lib/loadMore.ts — only the DOM-building/wiring
  // stays local to each page, since each page's rows look different.
  import { wireLoadMore } from "../lib/loadMore";

  // Progressive-enhancement second confirmation on top of the required
  // checkbox above (which alone already blocks accidental/no-JS submission)
  // — this is an irreversible action, so a real browser confirm() dialog is
  // a cheap extra guardrail for JS-enabled visitors.
  document.getElementById("delete-account-form")?.addEventListener("submit", (event) => {
    const sure = window.confirm(
      "This will permanently delete your account and cannot be undone. Continue?"
    );
    if (!sure) {
      event.preventDefault();
    }
  });

  // #196: GET /contributions/mine and GET /contributions/mine/votes now
  // return a {items, total, limit, offset} pagination envelope — this page
  // had no pagination UI at all before, so both sections get a simple
  // "Load more" button (no existing filter/approve-reject complexity to
  // integrate with here, unlike admin/moderation.astro's queue). Fetches
  // use a relative /api/v1/... path, same as every other client-side fetch
  // in this codebase (never a ${baseUrl}-prefixed one — see #218/#228).

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleDateString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function resolutionLabel(method: string | null): string | null {
    if (method === "moderator") return "moderator approval";
    if (method === "community_vote") return "community vote";
    return null;
  }

  interface FetchedContribution {
    id: number;
    series_id: number;
    episode_number: number;
    proposed_status: string;
    proposed_note: string | null;
    citation: { url?: string | null; description: string };
    submitted_at: string;
    review_status: string;
    resolution_method: string | null;
    review_note: string | null;
  }

  function buildContributionItem(c: FetchedContribution): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "item-card";

    const top = document.createElement("div");
    top.className = "item-top";
    const badge = document.createElement("span");
    // Matches StatusBadge.astro's own rendered markup/classes closely
    // enough for this page's own CSS (status-chip below carries the real
    // color); kept plain text here rather than reimplementing that
    // component's internals in client JS.
    badge.className = `status-chip status-chip--${c.proposed_status}`;
    badge.textContent = c.proposed_status;
    const target = document.createElement("span");
    target.className = "item-target";
    target.textContent = `Series #${c.series_id} · Episode ${c.episode_number}`;
    top.append(badge, target);
    li.append(top);

    if (c.proposed_note) {
      const note = document.createElement("p");
      note.className = "item-note";
      note.textContent = c.proposed_note;
      li.append(note);
    }

    const citation = document.createElement("p");
    citation.className = "item-citation";
    citation.append("Citation: ");
    if (c.citation.url) {
      const link = document.createElement("a");
      link.href = c.citation.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = c.citation.description;
      citation.append(link);
    } else {
      citation.append(c.citation.description);
    }
    li.append(citation);

    const meta = document.createElement("div");
    meta.className = "item-meta";
    const statusChip = document.createElement("span");
    statusChip.className = `status-chip status-chip--${c.review_status}`;
    statusChip.textContent = c.review_status;
    meta.append(statusChip);
    const resolution = resolutionLabel(c.resolution_method);
    if (resolution) {
      const resolutionEl = document.createElement("span");
      resolutionEl.className = "meta-note";
      resolutionEl.textContent = `via ${resolution}`;
      meta.append(resolutionEl);
    }
    const submitted = document.createElement("span");
    submitted.className = "meta-note";
    submitted.textContent = `submitted ${formatDate(c.submitted_at)}`;
    meta.append(submitted);
    li.append(meta);

    if (c.review_note) {
      const reviewNote = document.createElement("p");
      reviewNote.className = "review-note";
      reviewNote.textContent = `Reviewer note: ${c.review_note}`;
      li.append(reviewNote);
    }

    return li;
  }

  interface FetchedVote {
    contribution_id: number;
    series_id: number;
    series_title: string;
    episode_number: number;
    proposed_status: string;
    vote: string;
    weight_at_vote: number;
    review_status: string;
    resolution_method: string | null;
    created_at: string;
  }

  function buildVoteItem(v: FetchedVote): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "item-card";

    const top = document.createElement("div");
    top.className = "item-top";
    const voteChip = document.createElement("span");
    voteChip.className = `vote-chip vote-chip--${v.vote}`;
    voteChip.textContent = v.vote;
    const statusBadge = document.createElement("span");
    statusBadge.className = `status-chip status-chip--${v.proposed_status}`;
    statusBadge.textContent = v.proposed_status;
    const target = document.createElement("span");
    target.className = "item-target";
    target.textContent = `${v.series_title} · Episode ${v.episode_number}`;
    top.append(voteChip, statusBadge, target);
    li.append(top);

    const meta = document.createElement("div");
    meta.className = "item-meta";
    const statusChip = document.createElement("span");
    statusChip.className = `status-chip status-chip--${v.review_status}`;
    statusChip.textContent = v.review_status;
    meta.append(statusChip);
    const resolution = resolutionLabel(v.resolution_method);
    if (resolution) {
      const resolutionEl = document.createElement("span");
      resolutionEl.className = "meta-note";
      resolutionEl.textContent = `via ${resolution}`;
      meta.append(resolutionEl);
    }
    const weight = document.createElement("span");
    weight.className = "meta-note";
    weight.textContent = `weight at vote: ${v.weight_at_vote}`;
    meta.append(weight);
    const cast = document.createElement("span");
    cast.className = "meta-note";
    cast.textContent = `cast ${formatDate(v.created_at)}`;
    meta.append(cast);
    li.append(meta);

    return li;
  }

  function setupLoadMore<T>(
    buttonId: string,
    listId: string,
    pathBase: string,
    buildItem: (row: T) => HTMLLIElement
  ) {
    const button = document.getElementById(buttonId) as HTMLButtonElement | null;
    const list = document.getElementById(listId);
    if (!button || !list) return;

    wireLoadMore<T>({
      button,
      buildUrl: (offset) => `${pathBase}?limit=20&offset=${offset}`,
      onRow: (row) => list.append(buildItem(row)),
    });
  }

  setupLoadMore<FetchedContribution>(
    "contributions-load-more",
    "my-contributions-list",
    "/api/v1/contributions/mine",
    buildContributionItem
  );
  setupLoadMore<FetchedVote>(
    "votes-load-more",
    "my-votes-list",
    "/api/v1/contributions/mine/votes",
    buildVoteItem
  );
</script>

<style>
  .account-head {
    padding: 8px 0 20px;
  }
  .headline {
    font-size: 26px;
    font-weight: 800;
    color: var(--color-heading);
  }
  .sub {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }
  .role-chip,
  .trust-chip {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .role-chip {
    color: #fff;
    background: var(--color-accent);
    text-transform: capitalize;
  }
  .trust-chip {
    color: var(--color-text-muted);
    background: var(--color-trust-chip-bg);
  }

  .panel {
    background: var(--color-surface);
    border-radius: var(--radius-panel);
    padding: 24px 28px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-sticker);
  }
  .panel-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 14px;
  }

  .settings-block {
    padding: 14px 0;
    border-top: 2px dashed var(--color-border-divider);
  }
  .settings-block:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  .settings-label {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 800;
    color: var(--color-heading);
    margin-bottom: 4px;
  }
  .settings-note {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin: 0 0 10px;
    max-width: 60ch;
  }
  .provider-row {
    display: flex;
    gap: 18px;
  }
  .danger .settings-label {
    color: var(--color-dispute);
  }
  .confirm-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .empty {
    font-size: 13px;
    color: var(--color-text-faint);
  }

  /* #196: "Load more" — this page had no pagination UI at all before;
     styled as a plain outlined pill, same treatment as
     admin/moderation.astro's own .btn--load-more. */
  .btn-load-more {
    display: block;
    margin: 14px auto 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    border-radius: var(--radius-pill);
    padding: 7px 16px;
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-border-card);
    cursor: pointer;
  }
  .btn-load-more:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .item-card {
    background: var(--color-surface-pending);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-card);
    padding: 14px 16px;
  }
  .item-top {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .item-target {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-heading);
  }
  .item-note {
    font-size: 12.5px;
    color: var(--color-text);
    margin: 8px 0 4px;
  }
  .item-citation {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 4px 0;
  }
  .item-citation a {
    color: var(--color-accent);
  }
  .item-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .meta-note {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-faint);
  }
  .review-note {
    font-size: 12px;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 8px 0 0;
  }

  .status-chip {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: capitalize;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    color: #fff;
    background: var(--color-text-faint);
  }
  .status-chip--pending {
    background: var(--color-status-pending);
  }
  /* #164: white text on raw --color-status-canon (2.28:1, failing AA)
     switched to the same light-bg/dark-text "positive" pairing #143/#147
     established for the canon status badge — --color-status-canon itself
     stays untouched, still needed elsewhere at full saturation. Overrides
     the base .status-chip's white text. Computed 6.49:1. */
  .status-chip--approved {
    background: var(--color-status-canon-bg);
    color: var(--color-status-canon-text);
  }
  .status-chip--rejected {
    background: var(--color-dispute);
  }

  .vote-chip {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: capitalize;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    color: #fff;
  }
  /* #164: white text on raw --color-endorse (2.28:1, failing AA) switched to
     the same --color-endorse-bg + --color-status-canon-text pairing
     episodes/[id]/history.astro's own .banner--ok already uses for endorse-
     related UI (#143) — --color-endorse itself stays untouched, still
     needed elsewhere at full saturation. Overrides the base .vote-chip's
     white text. Computed 6.82:1. */
  .vote-chip--endorse {
    background: var(--color-endorse-bg);
    color: var(--color-status-canon-text);
  }
  .vote-chip--dispute {
    background: var(--color-dispute);
  }
</style>
