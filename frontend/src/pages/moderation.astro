---
// #39: moderation queue — pending contributions and series proposals, with
// approve/reject actions. Backend already gates approve/reject/list via
// require_moderator (core/deps.py) — this page's own job is only to hide
// the route/nav entry for anyone below moderator, not to re-implement that
// gate (see this issue's own scope note).
import Layout from "../layouts/Layout.astro";
import { createApiClient } from "../api/client";
import type { components } from "../api/schema.d.ts";

type ContributionOut = components["schemas"]["ContributionOut"];

// #85: schema.d.ts (the generated typed client) doesn't yet know about
// episode_data — same "not regenerating from a single-page worktree" call
// propose-series.astro's own comment already made for series-proposals in
// general (real risk of clobbering whatever else regenerates this shared
// file). Augmented locally instead; drop this once schema.d.ts is
// regenerated for real and picks up the field on its own.
type SeriesProposalOut = components["schemas"]["SeriesProposalOut"] & {
  episode_data?: {
    canon_ranges: string;
    mixed_ranges: string;
    filler_ranges: string;
    citation: { url?: string | null; description: string; methodology_note?: string | null };
    declared_count: number;
  } | null;
  // #150: same "schema.d.ts hasn't been regenerated" situation as
  // episode_data above — augmented locally, drop this augmentation once
  // schema.d.ts picks the field up on its own.
  possible_duplicate_matches?: { id: number; title: string; slug: string | null }[];
};

const MODERATOR_ROLES = ["moderator", "admin", "owner"];

const user = Astro.locals.user;
if (!user || !MODERATOR_ROLES.includes(user.role)) {
  return Astro.redirect("/");
}

const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";
const cookie = Astro.request.headers.get("cookie") ?? "";
const api = createApiClient(baseUrl);

const [contributionsResult, proposalsResult] = await Promise.all([
  api.GET("/api/v1/contributions", {
    params: { query: { review_status: "pending" } },
    headers: { cookie },
  }),
  api.GET("/api/v1/series-proposals", {
    params: { query: { review_status: "pending" } },
    headers: { cookie },
  }),
]);

const contributions: ContributionOut[] = contributionsResult.data ?? [];
const proposals: SeriesProposalOut[] = proposalsResult.data ?? [];
const loadError = Boolean(contributionsResult.error || proposalsResult.error);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleString(undefined, {
    dateStyle: "medium",
    timeStyle: "short",
  });
}
---

<Layout title="Review queue — AniFillerPedia" noindex>
  <section class="queue">
    <div class="disp heading">Review queue</div>
    <p class="sub">
      Pending community submissions. Approving promotes it live; rejecting requires a note so the
      contributor (or a future reader of the audit trail) understands why.
    </p>

    {loadError && (
      <div class="banner banner--error">
        Could not load the full queue from the API. Some items may be missing — try reloading.
      </div>
    )}

    <div id="toast" class="toast" hidden></div>

    <div class="panel">
      <div class="disp panel-title">Pending contributions <span class="count" id="contrib-count">{contributions.length}</span></div>
      {contributions.length === 0 && (
        <p class="empty" id="contrib-empty">Nothing pending right now.</p>
      )}
      {/* #3: bulk action bar — hidden until at least one checkbox in this
          panel is checked. Approve/reject both hit the new bulk-approve/
          bulk-reject endpoints once; the existing per-card buttons below
          are unchanged, for when only one item needs a decision. */}
      <div class="bulk-bar" id="contrib-bulk-bar" hidden>
        <label class="select-all">
          <input type="checkbox" id="contrib-select-all" />
          <span id="contrib-selected-count">0 selected</span>
        </label>
        <button type="button" class="btn btn--approve" id="contrib-bulk-approve">Approve selected</button>
        <div class="reject-group">
          <textarea
            class="review-note"
            id="contrib-bulk-note"
            placeholder="Review note (required — applied to every rejected item)"
            rows="2"
          ></textarea>
          <button type="button" class="btn btn--reject" id="contrib-bulk-reject" disabled>Reject selected</button>
        </div>
      </div>
      <ul class="cards" id="contrib-list">
        {contributions.map((c) => (
          <li class="card" data-kind="contribution" data-id={c.id}>
            <div class="card-top">
              <label class="select-one">
                <input type="checkbox" class="select-checkbox" aria-label="Select this contribution" />
              </label>
              <span class="target">Series #{c.series_id} · Episode #{c.episode_number}</span>
              <span class={`status-pill status-pill--${c.proposed_status}`}>{c.proposed_status}</span>
            </div>
            {c.proposed_note && <p class="note">{c.proposed_note}</p>}
            <div class="citation">
              <span class="label">Citation:</span>{" "}
              {c.citation.url ? (
                <a href={c.citation.url} target="_blank" rel="noopener noreferrer">
                  {c.citation.description}
                </a>
              ) : (
                <span>{c.citation.description}</span>
              )}
            </div>
            <div class="meta-row">
              <span>Submitted {formatDate(c.submitted_at)}</span>
              <span class="muted-note">
                Submitter not shown — this endpoint doesn't return identity (see #39 note)
              </span>
            </div>
            <div class="actions">
              <button type="button" class="btn btn--approve" data-action="approve">
                Approve
              </button>
              <div class="reject-group">
                <textarea
                  class="review-note"
                  placeholder="Review note (required to reject)"
                  rows="2"
                ></textarea>
                <button type="button" class="btn btn--reject" data-action="reject" disabled>
                  Reject
                </button>
              </div>
            </div>
            <p class="field-error" hidden>Reject requires a review note — add one above.</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel">
      <div class="disp panel-title">Pending series proposals <span class="count" id="proposal-count">{proposals.length}</span></div>
      {proposals.length === 0 && (
        <p class="empty" id="proposal-empty">Nothing pending right now.</p>
      )}
      <div class="bulk-bar" id="proposal-bulk-bar" hidden>
        <label class="select-all">
          <input type="checkbox" id="proposal-select-all" />
          <span id="proposal-selected-count">0 selected</span>
        </label>
        <button type="button" class="btn btn--approve" id="proposal-bulk-approve">Approve selected</button>
        <div class="reject-group">
          <textarea
            class="review-note"
            id="proposal-bulk-note"
            placeholder="Review note (required — applied to every rejected item)"
            rows="2"
          ></textarea>
          <button type="button" class="btn btn--reject" id="proposal-bulk-reject" disabled>Reject selected</button>
        </div>
      </div>
      <ul class="cards" id="proposal-list">
        {proposals.map((p) => (
          <li class="card" data-kind="proposal" data-id={p.id}>
            <div class="card-top">
              <label class="select-one">
                <input type="checkbox" class="select-checkbox" aria-label="Select this series proposal" />
              </label>
              <span class="target disp">{p.title}</span>
            </div>
            <div class="ids">
              {p.anilist_id && <span class="id-chip">AniList #{p.anilist_id}</span>}
              {p.mal_id && <span class="id-chip">MAL #{p.mal_id}</span>}
              {p.anidb_id && <span class="id-chip">AniDB #{p.anidb_id}</span>}
            </div>
            {p.possible_duplicate_matches && p.possible_duplicate_matches.length > 0 && (
              <p class="duplicate-hint">
                Possible match already in the catalog:{" "}
                {p.possible_duplicate_matches.map((m, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={m.slug ? `/series/${m.slug}` : `/series/${m.id}`} target="_blank" rel="noopener">
                      {m.title}
                    </a>
                  </>
                ))}
                — worth a look before approving.
              </p>
            )}
            <p class="note">{p.justification}</p>
            {p.episode_data && (
              <div class="episode-data-summary">
                <p class="episode-data-line">
                  <strong>+ {p.episode_data.declared_count} episode{p.episode_data.declared_count === 1 ? "" : "s"} attached</strong>{" "}
                  — approving this also creates those as pending contributions in one step.
                </p>
                <details class="episode-data-detail">
                  <summary>Show ranges + citation</summary>
                  {p.episode_data.canon_ranges && (
                    <p><span class="range-label range-label--canon"><span class="range-dot" />Canon</span> {p.episode_data.canon_ranges}</p>
                  )}
                  {p.episode_data.mixed_ranges && (
                    <p><span class="range-label range-label--mixed"><span class="range-dot" />Mixed</span> {p.episode_data.mixed_ranges}</p>
                  )}
                  {p.episode_data.filler_ranges && (
                    <p><span class="range-label range-label--filler"><span class="range-dot" />Filler</span> {p.episode_data.filler_ranges}</p>
                  )}
                  <p class="citation-line">{p.episode_data.citation.description}</p>
                  {p.episode_data.citation.url && (
                    <p><a href={p.episode_data.citation.url} target="_blank" rel="noopener">{p.episode_data.citation.url}</a></p>
                  )}
                </details>
              </div>
            )}
            <div class="meta-row">
              <span>Submitted {formatDate(p.submitted_at)}</span>
            </div>
            <div class="actions">
              <button type="button" class="btn btn--approve" data-action="approve">
                Approve
              </button>
              <div class="reject-group">
                <textarea
                  class="review-note"
                  placeholder="Review note (required to reject)"
                  rows="2"
                ></textarea>
                <button type="button" class="btn btn--reject" data-action="reject" disabled>
                  Reject
                </button>
              </div>
            </div>
            <p class="field-error" hidden>Reject requires a review note — add one above.</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  // Vanilla progressive enhancement — no client framework in this codebase
  // yet (Astro islands are reserved for when one is actually needed).
  // Approve/reject both call the backend directly from the browser; the
  // session cookie is forwarded automatically (same-origin in production,
  // Caddy fronts both frontend and backend under one domain).
  const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";

  const ENDPOINT: Record<string, (id: string) => { approve: string; reject: string }> = {
    contribution: (id) => ({
      approve: `${baseUrl}/api/v1/contributions/${id}/approve`,
      reject: `${baseUrl}/api/v1/contributions/${id}/reject`,
    }),
    proposal: (id) => ({
      approve: `${baseUrl}/api/v1/series-proposals/${id}/approve`,
      reject: `${baseUrl}/api/v1/series-proposals/${id}/reject`,
    }),
  };

  // #3: bulk counterparts — one call per action instead of one per item.
  const BULK_ENDPOINT: Record<string, { approve: string; reject: string }> = {
    contribution: {
      approve: `${baseUrl}/api/v1/contributions/bulk-approve`,
      reject: `${baseUrl}/api/v1/contributions/bulk-reject`,
    },
    proposal: {
      approve: `${baseUrl}/api/v1/series-proposals/bulk-approve`,
      reject: `${baseUrl}/api/v1/series-proposals/bulk-reject`,
    },
  };

  const toast = document.getElementById("toast") as HTMLDivElement | null;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  function showToast(message: string, tone: "info" | "error" = "info") {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.toggle("toast--error", tone === "error");
    toast.hidden = false;
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.hidden = true;
    }, 5000);
  }

  // #3: populated once wireBulkPanel runs for each kind — lets
  // updateEmptyState (used by the pre-existing single-item approve/reject
  // path too) keep each panel's bulk-bar count/visibility in sync even
  // when an item is removed via its own individual button, not just via
  // a bulk action.
  const bulkRefresh: Partial<Record<"contrib" | "proposal", () => void>> = {};

  function updateEmptyState(kind: "contrib" | "proposal") {
    const list = document.getElementById(`${kind}-list`);
    const empty = document.getElementById(`${kind}-empty`);
    const count = document.getElementById(`${kind}-count`);
    const remaining = list ? list.querySelectorAll("li.card").length : 0;
    if (count) count.textContent = String(remaining);
    if (remaining === 0 && list && !empty) {
      const p = document.createElement("p");
      p.className = "empty";
      p.id = `${kind}-empty`;
      p.textContent = "Nothing pending right now.";
      list.after(p);
    } else if (remaining > 0 && empty) {
      empty.remove();
    }
    bulkRefresh[kind]?.();
  }

  function removeCard(card: HTMLLIElement) {
    const kind = card.dataset.kind === "contribution" ? "contrib" : "proposal";
    card.remove();
    updateEmptyState(kind);
  }

  async function handleAction(card: HTMLLIElement, action: "approve" | "reject", reviewNote?: string) {
    const kind = card.dataset.kind as "contribution" | "proposal";
    const id = card.dataset.id as string;
    const endpoints = ENDPOINT[kind](id);
    const url = action === "approve" ? endpoints.approve : endpoints.reject;

    const buttons = card.querySelectorAll<HTMLButtonElement>("button");
    buttons.forEach((b) => (b.disabled = true));

    try {
      const response = await fetch(url, {
        method: "POST",
        credentials: "include",
        headers: action === "reject" ? { "Content-Type": "application/json" } : undefined,
        body: action === "reject" ? JSON.stringify({ review_note: reviewNote }) : undefined,
      });

      if (response.ok) {
        showToast(action === "approve" ? "Approved." : "Rejected.");
        removeCard(card);
        return;
      }

      if (response.status === 409 || response.status === 404) {
        // Someone else (a moderator, or a community vote crossing the
        // auto-approval threshold) resolved this between page load and
        // this click. Drop it from the queue rather than showing a raw
        // error — the queue's job is to show what's still actionable.
        showToast("Already resolved elsewhere — removed from your queue.", "error");
        removeCard(card);
        return;
      }

      let detail = `Request failed (${response.status}).`;
      try {
        const body = await response.json();
        if (typeof body?.detail === "string") detail = body.detail;
      } catch {
        // ignore parse failure, keep generic message
      }
      showToast(detail, "error");
      buttons.forEach((b) => (b.disabled = false));
      // Re-enable reject button according to its own note-length rule.
      const rejectBtn = card.querySelector<HTMLButtonElement>('[data-action="reject"]');
      const noteField = card.querySelector<HTMLTextAreaElement>(".review-note");
      if (rejectBtn && noteField) rejectBtn.disabled = noteField.value.trim().length === 0;
    } catch (err) {
      showToast("Network error — the action did not go through. Try again.", "error");
      buttons.forEach((b) => (b.disabled = false));
      const rejectBtn = card.querySelector<HTMLButtonElement>('[data-action="reject"]');
      const noteField = card.querySelector<HTMLTextAreaElement>(".review-note");
      if (rejectBtn && noteField) rejectBtn.disabled = noteField.value.trim().length === 0;
    }
  }

  document.querySelectorAll<HTMLLIElement>("li.card").forEach((card) => {
    const noteField = card.querySelector<HTMLTextAreaElement>(".review-note");
    const rejectBtn = card.querySelector<HTMLButtonElement>('[data-action="reject"]');
    const approveBtn = card.querySelector<HTMLButtonElement>('[data-action="approve"]');
    const fieldError = card.querySelector<HTMLParagraphElement>(".field-error");

    noteField?.addEventListener("input", () => {
      if (rejectBtn) rejectBtn.disabled = noteField.value.trim().length === 0;
      if (fieldError) fieldError.hidden = true;
    });

    approveBtn?.addEventListener("click", () => {
      void handleAction(card, "approve");
    });

    rejectBtn?.addEventListener("click", () => {
      const note = noteField?.value.trim() ?? "";
      if (!note) {
        // Client-side guard — the button is disabled while empty, but this
        // covers any path that reaches here anyway (e.g. a stale disabled
        // state) with a clear, specific message rather than letting a 422
        // from the backend be the first the moderator hears of it.
        if (fieldError) fieldError.hidden = false;
        return;
      }
      void handleAction(card, "reject", note);
    });
  });

  // #3: bulk approve/reject. Each panel (contributions, proposals) tracks
  // its own selection independently — a checkbox on one panel's cards
  // never affects the other's bulk bar.
  type BulkKind = "contrib" | "proposal";
  type ItemKind = "contribution" | "proposal";

  function wireBulkPanel(kind: BulkKind, itemKind: ItemKind) {
    const list = document.getElementById(`${kind}-list`);
    const bar = document.getElementById(`${kind}-bulk-bar`);
    const selectAll = document.getElementById(`${kind}-select-all`) as HTMLInputElement | null;
    const countLabel = document.getElementById(`${kind}-selected-count`);
    const approveBtn = document.getElementById(`${kind}-bulk-approve`) as HTMLButtonElement | null;
    const rejectBtn = document.getElementById(`${kind}-bulk-reject`) as HTMLButtonElement | null;
    const noteField = document.getElementById(`${kind}-bulk-note`) as HTMLTextAreaElement | null;
    if (!list || !bar || !selectAll || !countLabel || !approveBtn || !rejectBtn || !noteField) return;

    function selectedCards(): HTMLLIElement[] {
      return Array.from(list!.querySelectorAll<HTMLLIElement>("li.card")).filter(
        (card) => card.querySelector<HTMLInputElement>(".select-checkbox")?.checked
      );
    }

    function refresh() {
      const cards = Array.from(list!.querySelectorAll<HTMLLIElement>("li.card"));
      const selected = selectedCards();
      bar!.hidden = cards.length === 0;
      countLabel!.textContent = `${selected.length} selected`;
      approveBtn!.disabled = selected.length === 0;
      rejectBtn!.disabled = selected.length === 0 || noteField!.value.trim().length === 0;
      selectAll!.checked = cards.length > 0 && selected.length === cards.length;
      selectAll!.indeterminate = selected.length > 0 && selected.length < cards.length;
    }
    bulkRefresh[kind] = refresh;

    list.addEventListener("change", (e) => {
      if ((e.target as HTMLElement)?.classList.contains("select-checkbox")) refresh();
    });

    selectAll.addEventListener("change", () => {
      list!
        .querySelectorAll<HTMLInputElement>(".select-checkbox")
        .forEach((cb) => (cb.checked = selectAll!.checked));
      refresh();
    });

    noteField.addEventListener("input", refresh);

    async function runBulk(action: "approve" | "reject") {
      const cards = selectedCards();
      const ids = cards.map((c) => Number(c.dataset.id));
      if (ids.length === 0) return;

      approveBtn!.disabled = true;
      rejectBtn!.disabled = true;
      const url = BULK_ENDPOINT[itemKind][action];
      const body =
        action === "approve"
          ? { ids }
          : { ids, review_note: noteField!.value.trim() };

      try {
        const response = await fetch(url, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });

        if (!response.ok) {
          let detail = `Bulk request failed (${response.status}).`;
          try {
            const errBody = await response.json();
            if (typeof errBody?.detail === "string") detail = errBody.detail;
          } catch {
            // ignore parse failure, keep generic message
          }
          showToast(detail, "error");
          refresh();
          return;
        }

        const { results } = (await response.json()) as {
          results: { id: number; ok: boolean; detail: string | null }[];
        };
        const okIds = new Set(results.filter((r) => r.ok).map((r) => r.id));
        const failed = results.filter((r) => !r.ok);

        for (const card of cards) {
          if (okIds.has(Number(card.dataset.id))) removeCard(card);
        }

        if (failed.length === 0) {
          showToast(action === "approve" ? "Approved." : "Rejected.");
        } else {
          showToast(
            `${okIds.size} ${action === "approve" ? "approved" : "rejected"}, ` +
              `${failed.length} failed (already resolved elsewhere, or removed) — check the queue.`,
            "error"
          );
        }
        if (action === "reject") noteField!.value = "";
        refresh();
      } catch {
        showToast("Network error — the bulk action did not go through. Try again.", "error");
        refresh();
      }
    }

    approveBtn.addEventListener("click", () => void runBulk("approve"));
    rejectBtn.addEventListener("click", () => void runBulk("reject"));

    refresh();
  }

  wireBulkPanel("contrib", "contribution");
  wireBulkPanel("proposal", "proposal");
</script>

<style>
  .queue {
    padding-bottom: 24px;
  }
  .heading {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-heading);
  }
  .sub {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 6px 0 20px;
  }
  .banner {
    border-radius: var(--radius-card);
    padding: 10px 14px;
    font-size: 12.5px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  /* #147: was hardcoded #ffe1e6/#9f1d3a — promoted into tokens.css as
     --color-dispute-bg (now shared with the other pale-red error notices
     across the app) / --color-dispute (already darkened for #143). */
  .banner--error {
    background: var(--color-dispute-bg);
    color: var(--color-dispute);
  }
  .toast {
    position: sticky;
    top: 8px;
    z-index: 5;
    background: var(--color-surface-dark);
    color: #fff;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    font-size: 12.5px;
    font-weight: 700;
    margin-bottom: 16px;
    width: fit-content;
  }
  .toast--error {
    background: var(--color-dispute);
  }
  .panel {
    margin-bottom: 32px;
  }
  .panel-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-heading);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .bulk-bar {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-card);
    padding: 10px 14px;
    margin-bottom: 12px;
  }
  .select-all {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-text-muted);
    white-space: nowrap;
    padding-top: 7px;
  }
  .select-one {
    display: flex;
    align-items: center;
  }
  .select-checkbox,
  .select-all input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .count {
    font-family: var(--font-body);
    background: var(--color-trust-chip-bg);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 800;
  }
  .empty {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-faint);
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card {
    background: var(--color-surface-pending);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    box-shadow: var(--shadow-sticker);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .target {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-heading);
  }
  .status-pill {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
