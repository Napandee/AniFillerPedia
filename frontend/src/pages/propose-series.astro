---
// #36: "Propose a new series" form for shows not yet in the catalog.
// Backed by POST /api/v1/series-proposals — same shape as #35's
// contribution-submission flow, smaller surface (no episode/status fields).
//
// schema.d.ts (the generated typed client, #11) is stale relative to the
// real backend — it doesn't yet include /series-proposals at all (only
// health/version/series/episodes/auth/users routes are present). Rather
// than regenerating that shared generated file from this single-page
// worktree (real risk of clobbering whatever other Phase 5 branches
// regenerate it with, per the parallel-agent lessons in CLAUDE.local.md),
// this page calls the backend directly with `fetch` using the exact
// request/response shape confirmed straight from
// backend/schemas/series_proposals.py. Whoever next runs
// `npm run generate:api-client` picks this route up for free; this page
// can switch to the typed client at that point with no behavior change.
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import LicenseWhyDisclosure from "../components/LicenseWhyDisclosure.astro";

const user = Astro.locals.user;
const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";

// Not yet in env.d.ts's ImportMetaEnv (Turnstile site key isn't provisioned
// yet — see #25) — cast rather than declare, so this page doesn't need to
// touch env.d.ts for a key that has no real value to put there yet.
const turnstileSiteKey = (import.meta.env as Record<string, string | undefined>)
  .PUBLIC_TURNSTILE_SITE_KEY;

interface FormValues {
  title: string;
  anilist_id: string;
  mal_id: string;
  anidb_id: string;
  justification: string;
  // #85: optional episode-range data attached to the same submission —
  // same range-notation shorthand and field shape as #80's bulk-submit
  // form, so held on the proposal row until approval (see
  // services/series_proposals.py) rather than submitted as real
  // contributions targeting a series that doesn't exist yet.
  canon_ranges: string;
  mixed_ranges: string;
  filler_ranges: string;
  citation_url: string;
  citation_description: string;
  citation_methodology_note: string;
}

const emptyValues: FormValues = {
  title: "",
  anilist_id: "",
  mal_id: "",
  anidb_id: "",
  justification: "",
  canon_ranges: "",
  mixed_ranges: "",
  filler_ranges: "",
  citation_url: "",
  citation_description: "",
  citation_methodology_note: "",
};

let values: FormValues = emptyValues;
let licenseAccepted = false;
let fieldErrors: Record<string, string> = {};
let formError: string | null = null;
let success: { id: number; title: string; episodeDeclaredCount: number | null } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  values = {
    title: String(form.get("title") ?? ""),
    anilist_id: String(form.get("anilist_id") ?? ""),
    mal_id: String(form.get("mal_id") ?? ""),
    anidb_id: String(form.get("anidb_id") ?? ""),
    justification: String(form.get("justification") ?? ""),
    canon_ranges: String(form.get("canon_ranges") ?? ""),
    mixed_ranges: String(form.get("mixed_ranges") ?? ""),
    filler_ranges: String(form.get("filler_ranges") ?? ""),
    citation_url: String(form.get("citation_url") ?? ""),
    citation_description: String(form.get("citation_description") ?? ""),
    citation_methodology_note: String(form.get("citation_methodology_note") ?? ""),
  };
  licenseAccepted = form.get("license_accepted") === "on";
  const turnstileToken = String(form.get("turnstile_token") ?? "").trim();

  const toOptionalInt = (raw: string): number | undefined => {
    const trimmed = raw.trim();
    if (!trimmed) return undefined;
    const parsed = Number(trimmed);
    return Number.isFinite(parsed) ? Math.trunc(parsed) : undefined;
  };

  const body: Record<string, unknown> = {
    title: values.title,
    justification: values.justification,
    license_accepted: licenseAccepted,
  };
  const anilistId = toOptionalInt(values.anilist_id);
  const malId = toOptionalInt(values.mal_id);
  const anidbId = toOptionalInt(values.anidb_id);
  if (anilistId !== undefined) body.anilist_id = anilistId;
  if (malId !== undefined) body.mal_id = malId;
  if (anidbId !== undefined) body.anidb_id = anidbId;

  // #85: attach episode-range data only when the contributor actually
  // filled in at least one range — an all-blank block means "no episode
  // data this time," matching this form's existing "additive, not
  // required" behavior for everything else.
  const hasEpisodeData =
    values.canon_ranges.trim() || values.mixed_ranges.trim() || values.filler_ranges.trim();
  if (hasEpisodeData) {
    body.episode_data = {
      canon_ranges: values.canon_ranges,
      mixed_ranges: values.mixed_ranges,
      filler_ranges: values.filler_ranges,
      citation: {
        url: values.citation_url.trim() ? values.citation_url.trim() : undefined,
        description: values.citation_description,
        methodology_note: values.citation_methodology_note.trim()
          ? values.citation_methodology_note.trim()
          : undefined,
      },
    };
  }
  // Turnstile is only enforced server-side when the caller is anonymous
  // (matches #35's pattern exactly) — still forwarded either way, harmless
  // when logged in since the backend never checks it in that case.
  if (turnstileToken) body.turnstile_token = turnstileToken;

  const cookie = Astro.request.headers.get("cookie");

  try {
    const response = await fetch(`${baseUrl}/api/v1/series-proposals`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        ...(cookie ? { cookie } : {}),
      },
      body: JSON.stringify(body),
    });

    if (response.status === 201) {
      const data = await response.json();
      success = {
        id: data.id,
        title: data.title,
        episodeDeclaredCount: data.episode_data?.declared_count ?? null,
      };
      values = emptyValues;
      licenseAccepted = false;
    } else if (response.status === 422) {
      const data = await response.json();
      if (Array.isArray(data.detail)) {
        for (const err of data.detail) {
          const loc = Array.isArray(err?.loc) ? err.loc : [];
          const field = loc[loc.length - 1];
          if (typeof field === "string" && typeof err?.msg === "string") {
            fieldErrors[field] = err.msg;
          }
        }
        if (Object.keys(fieldErrors).length === 0) {
          formError = "Please check the form and try again.";
        }
      } else if (typeof data.detail === "string") {
        // e.g. "Turnstile verification failed"
        formError = data.detail;
      } else if (data.detail && typeof data.detail === "object" && "message" in data.detail) {
        // #85: episode_ranges.py's own business-rule 422 shape (a malformed
        // or self-contradictory range) — same plain-dict-detail shape
        // bulk-submit.astro's formatValidationError already handles.
        formError = String((data.detail as { message: unknown }).message);
      } else {
        formError = "Please check the form and try again.";
      }
    } else {
      formError = `Something went wrong (status ${response.status}). Please try again.`;
    }
  } catch {
    formError = "Could not reach the server. Please try again.";
  }
}
---

<Layout
  title="Propose a series — AniFillerPedia"
  description="Can't find a show in AniFillerPedia's catalog? Propose it here for community/moderator review."
>
  <section class="panel">
    {
      success ? (
        <div class="success">
          <div class="success-badge">Submitted</div>
          <h1 class="disp">Thanks for the proposal!</h1>
          <p>
            <strong>{success.title}</strong> has been submitted for review. A moderator (or enough
            trusted community votes) will need to approve it before it appears in the catalog —
            we'll take it from here.
            {success.episodeDeclaredCount !== null && (
              <>
                {" "}The {success.episodeDeclaredCount} episode{success.episodeDeclaredCount === 1 ? "" : "s"} of
                data you attached will be created the moment this proposal is approved — no
                separate bulk-submit step needed.
              </>
            )}
          </p>
          <div class="actions">
            <Button href="/">Back to browse</Button>
            <Button variant="ghost" href="/propose-series">
              Propose another
            </Button>
          </div>
        </div>
      ) : (
        <>
          <h1 class="disp">Propose a new series</h1>
          <p class="lede">
            Can't find a show in the catalog? Tell us about it — a moderator or the community will
            review it before it's added.
          </p>

          {formError && <div class="form-error">{formError}</div>}

          <form method="POST" novalidate>
            <label class="field">
              <span class="field-label">Title *</span>
              <input
                type="text"
                name="title"
                id="title-input"
                required
                value={values.title}
                maxlength="300"
                autocomplete="off"
              />
              {fieldErrors.title && <span class="field-error">{fieldErrors.title}</span>}
            </label>
            <!-- #150: populated on Title-field blur by the script below —
                 same non-blocking "possible match" pattern #165's AniList
                 preview card uses, so the two read as one consistent
                 signal to a submitter regardless of which path (title-only
                 or AniList-ID) surfaces it. -->
            <div class="match-panel" id="title-duplicate-panel" hidden></div>

            <div class="id-row">
              <label class="field">
                <span class="field-label">AniList ID</span>
                <input
                  type="number"
                  name="anilist_id"
                  id="anilist-id-input"
                  min="1"
                  step="1"
                  value={values.anilist_id}
                  autocomplete="off"
                />
                {fieldErrors.anilist_id && <span class="field-error">{fieldErrors.anilist_id}</span>}
              </label>
              <label class="field">
                <span class="field-label">MyAnimeList ID</span>
                <input type="number" name="mal_id" min="1" step="1" value={values.mal_id} />
                {fieldErrors.mal_id && <span class="field-error">{fieldErrors.mal_id}</span>}
              </label>
              <label class="field">
                <span class="field-label">AniDB ID</span>
                <input type="number" name="anidb_id" min="1" step="1" value={values.anidb_id} />
                {fieldErrors.anidb_id && <span class="field-error">{fieldErrors.anidb_id}</span>}
              </label>
            </div>
            <!-- #165: populated on AniList-ID-field blur by the script
                 below. MAL/AniDB stay plain numbers — no lookup client
                 exists for either (see this issue's own "out of scope"
                 note), so their hint text still says so explicitly. -->
            <div class="match-panel" id="anilist-lookup-panel" hidden></div>
            <p class="hint">
              AniList ID looks you up automatically when you tab away from the field. MyAnimeList
              and AniDB IDs are optional too, but have no lookup yet — just plain numbers.
            </p>

            <label class="field">
              <span class="field-label">Why should this be added? *</span>
              <textarea name="justification" required rows="5">{values.justification}</textarea>
              {fieldErrors.justification && (
                <span class="field-error">{fieldErrors.justification}</span>
              )}
            </label>

            <div class="episode-data-block">
              <p class="episode-data-heading">
                Already know the filler/canon breakdown? <span class="optional">(optional)</span>
              </p>
              <p class="hint">
                Paste episode ranges the same way you'd write them out by hand — e.g.{" "}
                <code>1-44, 48-49, 52-53</code>. Leave all three blank to just propose the series
                with no episode data yet — you (or anyone else) can bulk-submit it separately once
                the proposal is approved.
              </p>
              <label class="field">
                <span class="field-label">Canon episodes</span>
                <textarea
                  name="canon_ranges"
                  rows="2"
                  placeholder="1-44, 48-49, 52-53"
                  set:text={values.canon_ranges}
                />
              </label>
              <label class="field">
                <span class="field-label">Mixed canon/filler episodes</span>
                <textarea
                  name="mixed_ranges"
                  rows="2"
                  placeholder="45-47, 61"
                  set:text={values.mixed_ranges}
                />
              </label>
              <label class="field">
                <span class="field-label">Filler episodes</span>
                <textarea
                  name="filler_ranges"
                  rows="2"
                  placeholder="54-60, 98-99"
                  set:text={values.filler_ranges}
                />
              </label>
              <label class="field">
                <span class="field-label">Citation URL <span class="optional">(optional)</span></span>
                <input type="url" name="citation_url" value={values.citation_url} placeholder="https://..." />
              </label>
              <label class="field">
                <span class="field-label">
                  Citation description <span class="optional">(required if any range above is filled in)</span>
                </span>
                <textarea
                  name="citation_description"
                  rows="3"
                  placeholder="e.g. Community-compiled Reddit breakdown, corroborated by a second independent thread..."
                  set:text={values.citation_description}
                />
                {fieldErrors.description && (
                  <span class="field-error">{fieldErrors.description}</span>
                )}
              </label>
              <label class="field">
                <span class="field-label">
                  More detail on how you verified this <span class="optional">(optional)</span>
                </span>
                <textarea
                  name="citation_methodology_note"
                  rows="3"
                  placeholder="e.g. cross-referenced against a second independent thread, noted any disagreement and how it was resolved..."
                  set:text={values.citation_methodology_note}
                />
              </label>
            </div>

            <label class="checkbox-field">
              <input type="checkbox" name="license_accepted" required checked={licenseAccepted} />
              <span>
                I agree my contribution is released under the project's{" "}
                <a href="/license">CC BY-NC-SA 4.0 data license</a>. *
                <LicenseWhyDisclosure reason="a series proposal needs traceable proof it was released under this license — that's what keeps the catalog freely reusable, Wikipedia-style." />
              </span>
            </label>
            {fieldErrors.license_accepted && (
              <span class="field-error">{fieldErrors.license_accepted}</span>
            )}

            {!user && (
              <div class="turnstile-block">
                {turnstileSiteKey ? (
                  <>
                    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
                    <script
                      is:inline
                      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                      async
                      defer
                    />
                  </>
                ) : (
                  // Turnstile site key not provisioned yet (issue #25) — the
                  // backend's verify() short-circuits to allowed=True while
                  // no secret key is configured (backend/services/turnstile.py),
                  // so a stub token doesn't block submission. Swap this block
                  // for the real widget once #25's site key exists.
                  <input
                    type="hidden"
                    name="turnstile_token"
                    value="stub-pending-turnstile-provisioning"
                  />
                )}
              </div>
            )}

            <div class="actions">
              <Button type="submit">Submit proposal</Button>
            </div>
          </form>
        </>
      )
    }
  </section>
</Layout>

<script>
  // #150/#165: two "this might already exist" signals sharing one visual
  // pattern (see .match-panel/.match-card/.match-note in the style block
  // below) — title-similarity for the no-ID path, AniList-ID lookup for
  // the ID-present path — built together so a submitter sees one
  // consistent kind of hint regardless of which one fires. Vanilla DOM,
  // no framework island, matching moderation.astro's own progressive-
  // enhancement approach elsewhere in this codebase.
  const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function seriesUrl(id: number, slug?: string | null): string {
    return slug ? `/series/${slug}` : `/series/${id}`;
  }

  function clearPanel(panel: HTMLElement | null) {
    if (!panel) return;
    panel.hidden = true;
    panel.innerHTML = "";
  }

  const titleInput = document.getElementById("title-input") as HTMLInputElement | null;

  // --- #150: title-similarity duplicate hint (no-ID path) ---------------

  const titlePanel = document.getElementById("title-duplicate-panel");
  let lastCheckedTitle: string | null = null;

  async function checkTitleForDuplicates() {
    if (!titleInput || !titlePanel) return;
    const raw = titleInput.value.trim();
    if (!raw) {
      lastCheckedTitle = null;
      clearPanel(titlePanel);
      return;
    }
    // Guard against refiring on an unchanged value (e.g. tabbing through
    // the field without editing it) — same guard #165's lookup uses below.
    if (raw === lastCheckedTitle) return;
    lastCheckedTitle = raw;
    try {
      const response = await fetch(
        `${baseUrl}/api/v1/series-proposals/check-title?title=${encodeURIComponent(raw)}`
      );
      if (!response.ok) return;
      const data: { matches: { id: number; title: string; slug: string | null }[] } =
        await response.json();
      if (!data.matches || data.matches.length === 0) {
        clearPanel(titlePanel);
        return;
      }
      const links = data.matches
        .map(
          (m) =>
            `<a href="${seriesUrl(m.id, m.slug)}" target="_blank" rel="noopener">${escapeHtml(m.title)}</a>`
        )
        .join(", ");
      titlePanel.hidden = false;
      titlePanel.innerHTML = `<p class="match-note">This might already exist in the catalog: ${links}. Just a heads-up — not a block, submit anyway if it's genuinely a different show.</p>`;
    } catch {
      // Non-blocking hint — a network hiccup here should never stop the
      // submitter from finishing and submitting the rest of the form.
    }
  }

  titleInput?.addEventListener("blur", () => {
    void checkTitleForDuplicates();
  });

  // --- #165: live AniList-ID lookup + early duplicate detection ---------

  const anilistIdInput = document.getElementById("anilist-id-input") as HTMLInputElement | null;
  const anilistPanel = document.getElementById("anilist-lookup-panel");
  let lastCheckedAnilistId: string | null = null;

  async function checkAnilistId() {
    if (!anilistIdInput || !anilistPanel) return;
    const raw = anilistIdInput.value.trim();
    if (!raw) {
      lastCheckedAnilistId = null;
      clearPanel(anilistPanel);
      return;
    }
    if (raw === lastCheckedAnilistId) return;
    lastCheckedAnilistId = raw;
    try {
      const response = await fetch(`${baseUrl}/api/v1/anilist-lookup/${encodeURIComponent(raw)}`);
      if (!response.ok) {
        clearPanel(anilistPanel);
        return;
      }
      const data: {
        status: "found" | "already_exists" | "not_found";
        title: string | null;
        format: string | null;
        episode_count: number | null;
        cover_image_url: string | null;
        existing_series_id: number | null;
        existing_series_slug: string | null;
      } = await response.json();

      anilistPanel.hidden = false;

      if (data.status === "already_exists") {
        anilistPanel.innerHTML = `<div class="match-card match-card--exists"><p class="match-note">This AniList entry is already in the catalog: <a href="${seriesUrl(
          data.existing_series_id ?? 0,
          data.existing_series_slug
        )}" target="_blank" rel="noopener">${escapeHtml(data.title ?? "View series")}</a>.</p></div>`;
        return;
      }

      if (data.status === "found") {
        const meta = [data.format, data.episode_count ? `${data.episode_count} episodes` : null]
          .filter(Boolean)
          .join(" · ");
        anilistPanel.innerHTML = `
          <div class="match-card">
            ${data.cover_image_url ? `<img class="match-cover" src="${data.cover_image_url}" alt="" />` : ""}
            <div class="match-card-body">
              <p class="match-card-title">${escapeHtml(data.title ?? "")}</p>
              ${meta ? `<p class="match-card-meta">${escapeHtml(meta)}</p>` : ""}
              <div class="match-actions">
                <button type="button" class="match-btn" data-action="confirm">Yes, this one</button>
                <button type="button" class="match-btn match-btn--ghost" data-action="dismiss">Not this one</button>
              </div>
            </div>
          </div>
        `;
        const confirmBtn = anilistPanel.querySelector<HTMLButtonElement>('[data-action="confirm"]');
        const dismissBtn = anilistPanel.querySelector<HTMLButtonElement>('[data-action="dismiss"]');
        confirmBtn?.addEventListener("click", () => {
          // Autofills as an editable starting point — never locks the
          // field, per this issue's own explicit requirement.
          if (titleInput && data.title) titleInput.value = data.title;
          anilistPanel.querySelector(".match-card")?.classList.add("match-card--confirmed");
          if (confirmBtn) confirmBtn.disabled = true;
          if (dismissBtn) dismissBtn.disabled = true;
        });
        dismissBtn?.addEventListener("click", () => clearPanel(anilistPanel));
        return;
      }

      // "not_found" — non-blocking, the rest of the form stays fully
      // usable regardless (all three ID fields are optional).
      anilistPanel.innerHTML = `<p class="match-note match-note--muted">No AniList entry found for that ID.</p>`;
    } catch {
      clearPanel(anilistPanel);
    }
  }

  anilistIdInput?.addEventListener("blur", () => {
    void checkAnilistId();
  });
</script>

<style>
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-sticker);
    padding: 28px 32px 32px;
    max-width: 640px;
    margin: 0 auto;
  }
  h1 {
    color: var(--color-heading);
    font-size: 24px;
    margin: 0 0 6px;
  }
  .lede {
    color: var(--color-text-muted);
    font-size: 13.5px;
    font-weight: 600;
    margin: 0 0 20px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .field-label {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--color-heading);
  }
  input[type="text"],
  input[type="number"],
  textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text);
    border: 1px solid var(--color-border-card);
    border-radius: 10px;
    padding: 9px 11px;
    background: #fff;
  }
  textarea {
    resize: vertical;
  }
  .id-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .hint {
    margin: -8px 0 0;
    font-size: 12px;
    color: var(--color-text-faint);
  }
  /* #150/#165: shared "this might already exist" pattern — one visual
     language for both the title-similarity hint (no-ID path) and the
     AniList-lookup preview/already-exists card (ID-present path), so the
     two read as one consistent signal rather than two unrelated
     features bolted on separately. */
  .match-panel {
    margin: -8px 0 0;
  }
  .match-note {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
    background: var(--color-surface-pending);
    border: 1px solid var(--color-border-card);
    border-radius: 10px;
    padding: 9px 12px;
  }
  .match-note a {
    color: var(--color-accent);
    font-weight: 700;
  }
  .match-note--muted {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-text-faint);
  }
  .match-card {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--color-surface-pending);
    border: 1px solid var(--color-border-card);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .match-card--exists {
    background: var(--color-endorse-bg);
    border-color: var(--color-endorse);
  }
  .match-card--exists .match-note {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-text);
  }
  .match-card--confirmed {
    opacity: 0.65;
  }
  .match-cover {
    width: 52px;
    height: 74px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .match-card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .match-card-title {
    margin: 0;
    font-weight: 800;
    font-size: 13.5px;
    color: var(--color-heading);
