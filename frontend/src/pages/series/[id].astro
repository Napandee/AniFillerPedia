---
// #33 (original scaffold) / #51 (this redesign): the series detail page —
// dashboard-style canon/filler/mixed overview, collapsible synonyms, and a
// decluttered episode list with per-row disclosure for citation/actions.
// Backed by GET /api/v1/series/{id} (header data) and
// GET /api/v1/series/{id}/episodes (the list itself, now including a
// nullable aired_at per #49/#51, a nullable title per #73, and citation.
// source_count per #74). Per CLAUDE.md, episode numbering is absolute and
// status is one of exactly three values (no `recap`).
//
// output: "server" means this route is resolved per-request — no
// getStaticPaths() needed, Astro.params.id is read directly.
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import Button from "../../components/Button.astro";
import CoverFallback from "../../components/CoverFallback.astro";
import { createApiClient } from "../../api/client";
import type { components } from "../../api/schema";

type SeriesDetailOut = components["schemas"]["SeriesDetailOut"];
type EpisodeOut = components["schemas"]["EpisodeOut"];

const api = createApiClient(import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000");

const rawId = Astro.params.id ?? "";
const seriesId = Number(rawId);
const idLooksValid = rawId !== "" && Number.isInteger(seriesId) && seriesId > 0;

let notFound = !idLooksValid;
let series: SeriesDetailOut | null = null;
let episodes: EpisodeOut[] = [];

if (idLooksValid) {
  const { data: seriesData, response: seriesResponse } = await api.GET("/api/v1/series/{series_id}", {
    params: { path: { series_id: seriesId } },
  });

  if (seriesResponse.status === 404 || !seriesData) {
    // Covers both the real 404 the backend raises for an unknown id and any
    // other non-success response — either way there's nothing to render.
    notFound = true;
  } else {
    series = seriesData;
    const { data: episodesData } = await api.GET("/api/v1/series/{series_id}/episodes", {
      params: { path: { series_id: seriesId } },
    });
    // An empty array is a normal, valid response (zero-episode series) —
    // `?? []` only guards against a genuinely failed/undefined fetch.
    episodes = (episodesData ?? []).slice().sort((a, b) => a.episode_number - b.episode_number);
  }
}

if (notFound) {
  Astro.response.status = 404;
}

// #51: full canon/filler/mixed breakdown for the dashboard cards, computed
// client-side from the fetched episode list — no dedicated backend field
// for this, same approach #33 originally used for the single "filler-free"
// stat this replaces.
const totalEpisodes = episodes.length;
const canonCount = episodes.filter((ep) => ep.status === "canon").length;
const fillerCount = episodes.filter((ep) => ep.status === "filler").length;
const mixedCount = episodes.filter((ep) => ep.status === "mixed").length;
const pct = (n: number) => (totalEpisodes > 0 ? Math.round((n / totalEpisodes) * 100) : 0);

// #94: range-notation summary — the literal filler-guide shorthand
// ("Canon: 1-44, 48-49...") grouped by status, computed from the same
// already-fetched episode list the stat cards above use (no new API
// surface). `episodes` is sorted by episode_number but may have GAPS
// (only researched episodes exist) — a gap always breaks a run, same as
// a status change, so e.g. episodes 1-5 then 7-10 canon (6 unresearched)
// renders as two separate ranges, never a false "1-10".
type EpisodeStatus = "canon" | "filler" | "mixed";
const STATUS_LABELS: Record<EpisodeStatus, string> = { canon: "Canon", filler: "Filler", mixed: "Mixed" };
const STATUS_ORDER: EpisodeStatus[] = ["canon", "filler", "mixed"];

function computeRangeGroups(eps: EpisodeOut[]): { status: EpisodeStatus; ranges: string[] }[] {
  const byStatus: Record<EpisodeStatus, string[]> = { canon: [], filler: [], mixed: [] };
  let curStatus: EpisodeStatus | null = null;
  let start = 0;
  let prev = 0;
  for (const ep of eps) {
    const n = ep.episode_number;
    const status = ep.status as EpisodeStatus;
    if (status !== curStatus || n !== prev + 1) {
      if (curStatus !== null) {
        byStatus[curStatus].push(start === prev ? `${start}` : `${start}–${prev}`);
      }
      curStatus = status;
      start = n;
    }
    prev = n;
  }
  if (curStatus !== null) {
    byStatus[curStatus].push(start === prev ? `${start}` : `${start}–${prev}`);
  }
  return STATUS_ORDER.map((status) => ({ status, ranges: byStatus[status] })).filter((g) => g.ranges.length > 0);
}

// First 10 ranges per status show inline; the rest sit behind a "+N more"
// <details> toggle so a heavily-fragmented show (e.g. Meitantei Conan:
// ~195 canon ranges alone) doesn't dump as a wall of numbers by default —
// verified against real data for both a moderately fragmented show
// (Naruto: Shippuuden, 85 runs) and a highly fragmented one (Conan, 390
// runs) during the #94 design pass before settling on this shape.
const RANGE_SUMMARY_VISIBLE_COUNT = 10;
const rangeGroups = computeRangeGroups(episodes);

// #55: the real total episode count (#49's AniList sync) is independent of
// how many episodes have actually been hand-researched — showing just
// "100 episodes tracked" implied that was the whole show. Null until #49's
// worker has synced this series at least once; falls back to the old
// wording rather than showing a misleading "100 of null".
const totalKnownEpisodes = series?.anilist_episode_count ?? null;

const pageTitle = series ? `${series.title} — AniFillerPedia` : "Series not found — AniFillerPedia";

// #46/#49: cover/banner art comes straight from our own API now — synced
// by the backend worker on a daily cadence, not fetched live from AniList
// on every page load (a real AniList outage previously took cover art down
// site-wide, since it used to be a synchronous per-request dependency).
// Null (never a broken image) whenever the sync hasn't reached this series
// yet, same as before.
const bannerUrl = series?.banner_image_url ?? series?.cover_image_url ?? null;

// #51: aired_at is nullable (#49's AniList sync doesn't reach every
// episode — notably not the earlier episodes of an already-finished long
// show, since AniList's own schedule data only retains a rolling window).
// Render nothing at all for an episode with no synced date, rather than
// "Invalid Date" or a placeholder implying data that doesn't exist.
const formatAiredAt = (iso: string | null) =>
  iso === null
    ? null
    : new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// #63: a real, data-driven meta description — never generic boilerplate.
// Distinct copy for "nothing researched yet" vs. a series with real stats,
// since claiming a filler percentage with zero episodes tracked would be
// actively misleading.
const pageDescription =
  series &&
  (totalEpisodes > 0
    ? `${series.title} filler episode guide — ${totalEpisodes}${
        totalKnownEpisodes && totalKnownEpisodes > totalEpisodes ? ` of ${totalKnownEpisodes}` : ""
      } episodes tracked, ${pct(canonCount)}% canon. See exactly which episodes to skip, every claim cited.`
    : `${series.title} on AniFillerPedia — no episodes researched yet. Help build the filler/canon guide for this series.`);

// schema.org structured data — only when there's a real series to describe.
// numberOfEpisodes prefers the real AniList total over what's been
// hand-researched so far; sameAs links out to the AniList entry when known.
const structuredData = series
  ? {
      "@context": "https://schema.org",
      "@type": "TVSeries",
      name: series.title,
      url: new URL(`/series/${seriesId}`, Astro.site).toString(),
      ...(series.synonyms.length > 0 ? { alternateName: series.synonyms } : {}),
      ...(totalKnownEpisodes ? { numberOfEpisodes: totalKnownEpisodes } : {}),
      ...(series.anilist_id ? { sameAs: [`https://anilist.co/anime/${series.anilist_id}`] } : {}),
    }
  : undefined;
---

<Layout
  title={pageTitle}
  description={pageDescription || undefined}
  image={bannerUrl ?? undefined}
  noindex={notFound}
  structuredData={structuredData}
>
  {
    notFound ? (
      <section class="not-found">
        <div class="disp not-found-title">Series not found</div>
        <p>There's no series with that id in AniFillerPedia yet.</p>
        <Button href="/" variant="ghost">
          &larr; Back to browse
        </Button>
      </section>
    ) : (
      <>
        <section class="series-header">
          <div class:list={["banner", { "banner--photo": !!bannerUrl }]}>
            {bannerUrl ? (
              <>
                <div class="banner-img" style={`background-image:url(${bannerUrl})`} />
                <div class="banner-scrim" />
              </>
            ) : (
              <CoverFallback title={series!.title} fontSize="56px" />
            )}
          </div>
          <div class="hero-row">
            <div class="thumb">
              {series!.cover_image_url ? (
                <img src={series!.cover_image_url} alt="" loading="lazy" />
              ) : (
                <CoverFallback title={series!.title} fontSize="28px" />
              )}
            </div>
            <div class="title-block">
              <div class="disp title">{series!.title}</div>
            </div>
          </div>

          {series!.synonyms.length > 0 && (
            <details class="synonyms">
              <summary>Also known as ({series!.synonyms.length})</summary>
              <p class="synonyms-list">{series!.synonyms.join(", ")}</p>
            </details>
          )}

          {series!.related_series.length > 0 && (
            <div class="related-series">
              <span class="related-series-label">Also on this site:</span>
              {series!.related_series.map((related) => (
                <a class="related-series-link" href={`/series/${related.id}`}>
                  {related.title}
                </a>
              ))}
            </div>
          )}

          {totalEpisodes > 0 && (
            <div class="stat-cards" id="stat-cards">
              <button class="stat-card" data-status="canon" data-count={canonCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--canon">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                  </span>
                  <span class="stat-name">Canon</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{canonCount}</div>
                <div class="stat-pct">{pct(canonCount)}% of tracked</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--canon" style={`width:${pct(canonCount)}%`} /></div>
              </button>

              <button class="stat-card" data-status="filler" data-count={fillerCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--filler">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><polygon points="13 2 4 14 11 14 10 22 20 9 13 9 13 2" /></svg>
                  </span>
                  <span class="stat-name">Filler</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{fillerCount}</div>
                <div class="stat-pct">{pct(fillerCount)}% of tracked</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--filler" style={`width:${pct(fillerCount)}%`} /></div>
              </button>

              <button class="stat-card" data-status="mixed" data-count={mixedCount} type="button">
                <div class="stat-card-top">
                  <span class="stat-icon stat-icon--mixed">
                    <svg width="13" height="13" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" /></svg>
                  </span>
                  <span class="stat-name">Mixed</span>
                  <svg class="stat-active-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6" /></svg>
                </div>
                <div class="stat-number">{mixedCount}</div>
                <div class="stat-pct">{pct(mixedCount)}% of tracked</div>
                <div class="stat-mini-bar"><div class="stat-mini-fill stat-mini-fill--mixed" style={`width:${pct(mixedCount)}%`} /></div>
              </button>
            </div>
          )}

          <div class="stat-row">
            <span class="stat-chip">
              {totalKnownEpisodes !== null && totalKnownEpisodes > totalEpisodes
                ? `${totalEpisodes} of ${totalKnownEpisodes} episodes tracked`
                : `${totalEpisodes} episode${totalEpisodes === 1 ? "" : "s"} tracked`}
            </span>
          </div>

          {/* #94: the literal range-notation summary, grouped by status —
              a complementary detail view under the stat cards above, not a
              replacement for them. */}
          {rangeGroups.length > 0 && (
            <div class="range-summary">
              {rangeGroups.map((group) => {
                const visible = group.ranges.slice(0, RANGE_SUMMARY_VISIBLE_COUNT);
                const remainder = group.ranges.slice(RANGE_SUMMARY_VISIBLE_COUNT);
                return (
                  <div class="range-group">
                    <span class={`range-label range-label--${group.status}`}>
                      <span class="range-dot" />
                      {STATUS_LABELS[group.status]}
                    </span>
                    <span class="range-text">
                      {visible.join(", ")}
                      {remainder.length > 0 && (
                        <details class="range-more">
                          <summary><span class="range-more-count">+{remainder.length} more</span></summary>
                          <span class="range-more-text">{remainder.join(", ")}</span>
                        </details>
                      )}
                    </span>
                  </div>
                );
              })}
            </div>
          )}

          {totalEpisodes > 0 && (
            <div class="filter-chip-row" id="filter-chip-row" hidden>
              <span class="filter-chip">
                Showing: <span id="filter-chip-label">filler</span> episodes only (<span id="filter-chip-count">0</span>)
                <button type="button" id="filter-clear">&#10005; clear</button>
              </span>
            </div>
          )}
        </section>

        <section class="episode-list">
          {episodes.length === 0 ? (
            <div class="empty-state">
              <p class="disp empty-title">No episodes researched yet</p>
              <p>Nobody has submitted filler/canon data for this series yet — be the first.</p>
              <Button href={`/series/${seriesId}/episodes/1/submit`} variant="primary">
                Submit episode 1
              </Button>
            </div>
          ) : (
            episodes.map((episode) => {
              const airedAt = formatAiredAt(episode.aired_at ?? null);
              const lastVerified = formatAiredAt(episode.updated_at);
              return (
                <details class="episode-row" data-status={episode.status}>
                  <summary class="episode-row-head">
                    <span class="episode-number">Ep. {episode.episode_number}</span>
                    {/* #73: reopens #33's "skip for v1" call — empty when
                        untitled (most episodes, for a long time), same
                        stable-grid-column convention #55 established for
                        air-date below. */}
                    <span class="episode-title-inline">{episode.title}</span>
                    <StatusBadge status={episode.status as "canon" | "filler" | "mixed"} />
                    {/* #55: always rendered, even when empty — omitting this
                        span entirely when aired_at is unknown left only 3
                        grid children for a 4-column grid, so the chevron
                        landed in the 3rd (1fr) column instead of the last
                        one, right next to the badge instead of the far
                        right edge. An empty cell keeps the column count
                        stable without showing placeholder text. */}
                    <span class="air-date">{airedAt}</span>
                    <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                  </summary>
                  <div class="episode-detail">
                    {episode.citation.url ? (
                      <a class="citation-text" href={episode.citation.url} target="_blank" rel="noopener noreferrer">
                        {episode.citation.description}
                      </a>
                    ) : (
                      <p class="citation-text">{episode.citation.description}</p>
                    )}
                    {/* #77: the full research trail, split out of the short
                        description above — omitted entirely when there's
                        nothing more to say than that. */}
                    {episode.citation.methodology_note && (
                      <details class="methodology">
                        <summary>How was this verified?</summary>
                        <p class="methodology-note">{episode.citation.methodology_note}</p>
                      </details>
                    )}
                    {/* #74: omitted entirely at the default of 1 — a single-
                        source citation isn't a corroboration claim, don't
                        imply one. */}
                    {episode.citation.source_count > 1 && (
                      <div class="trust-badge">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><polyline points="9 12 11 14 15 10" /></svg>
                        {episode.citation.source_count} independent sources agree
                      </div>
                    )}
                    {episode.status_note && <p class="status-note">{episode.status_note}</p>}
                    <p class="verified-line">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                      Last verified {lastVerified}
                    </p>
                    <div class="detail-actions">
                      <Button href={`/episodes/${episode.id}/history`} variant="ghost">
                        History &amp; votes
                      </Button>
                      <Button href={`/series/${seriesId}/episodes/${episode.episode_number}/submit`} variant="primary">
                        Submit correction
                      </Button>
                    </div>
                  </div>
                </details>
              );
            })
          )}
        </section>

        <script>
          // #51: click a stat card to filter the episode list to that
          // status only; click the same card again (or "clear") to reset.
          // Purely client-side — every episode is already in the fetched
          // page, so this never issues a new request.
          const cardsContainer = document.getElementById("stat-cards");
          const chipRow = document.getElementById("filter-chip-row");
          const chipLabel = document.getElementById("filter-chip-label");
          const chipCount = document.getElementById("filter-chip-count");
          const clearButton = document.getElementById("filter-clear");
          const rows = Array.from(document.querySelectorAll<HTMLElement>(".episode-row"));

          function applyFilter(status: string | null) {
            for (const row of rows) {
              row.hidden = status !== null && row.dataset.status !== status;
            }
            for (const card of cardsContainer?.querySelectorAll<HTMLElement>(".stat-card") ?? []) {
              card.classList.toggle("is-active", card.dataset.status === status);
            }
            if (status === null) {
              chipRow?.setAttribute("hidden", "");
            } else {
              chipRow?.removeAttribute("hidden");
              if (chipLabel) chipLabel.textContent = status;
              const activeCard = cardsContainer?.querySelector<HTMLElement>(`.stat-card[data-status="${status}"]`);
              if (chipCount) chipCount.textContent = activeCard?.dataset.count ?? "0";
            }
          }

          cardsContainer?.addEventListener("click", (event) => {
            const card = (event.target as HTMLElement).closest<HTMLElement>(".stat-card");
            if (!card) return;
            const isActive = card.classList.contains("is-active");
            applyFilter(isActive ? null : card.dataset.status ?? null);
          });

          clearButton?.addEventListener("click", () => applyFilter(null));
        </script>
      </>
    )
  }
</Layout>

<style>
  .not-found {
    background: var(--color-surface);
    border-radius: var(--radius-panel);
    padding: 36px 32px;
    text-align: center;
  }
  .not-found-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-heading);
    margin-bottom: 8px;
  }
  .not-found p {
    color: var(--color-text-muted);
    font-size: 13.5px;
    font-weight: 600;
    margin: 0 0 20px;
  }

  .series-header {
    border-radius: var(--radius-panel);
    margin-bottom: 20px;
    overflow: visible;
  }
  .banner {
    height: 190px;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    position: relative;
    overflow: hidden;
  }
  .banner:not(.banner--photo) {
    background: linear-gradient(135deg, var(--color-bg-hero-start), var(--color-bg-hero-end));
  }
  .banner-img {
    position: absolute;
    inset: -12px;
    background-size: cover;
    background-position: center;
    filter: blur(10px) brightness(0.45);
  }
  .banner-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 6, 12, 0.85), rgba(15, 6, 12, 0.35) 75%, rgba(15, 6, 12, 0.15));
  }
  .hero-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 0 24px;
    margin-top: -58px;
    position: relative;
  }
  .thumb {
    width: 104px;
    flex-shrink: 0;
    aspect-ratio: 2 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: 3px solid var(--color-bg);
    box-shadow: 0 6px 16px rgba(20, 10, 20, 0.35);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .title-block {
    padding-bottom: 12px;
  }
  .title {
    font-size: 26px;
    font-weight: 800;
    color: #fff8f2;
    line-height: 1.15;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  /* #51: collapsed by default — a 40+ entry synonym list used to run for
     several unbroken lines under the title. Native <details> needs no JS
     and no custom open/close state to wire up. */
  .synonyms {
    margin: 12px 24px 0;
  }
  .synonyms summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    box-shadow: var(--shadow-sticker);
    cursor: pointer;
    list-style: none;
    width: fit-content;
  }
  .synonyms summary::-webkit-details-marker {
    display: none;
  }
  .synonyms summary::after {
    content: "▾";
    font-size: 10px;
  }
  .synonyms[open] summary::after {
    content: "▴";
  }
  .synonyms-list {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 8px 4px 0;
    line-height: 1.6;
  }

  /* A show split across multiple real AniList entries (e.g. Fairy Tail /
     Fairy Tail (2014) / Fairy Tail (2018)) — see series_relations in
     schema.sql. Empty for the vast majority of series. */
  .related-series {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 24px 0;
    font-size: 12.5px;
  }
  .related-series-label {
    font-weight: 700;
    color: var(--color-text-faint);
  }
  .related-series-link {
    font-weight: 800;
    color: var(--color-accent);
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    box-shadow: var(--shadow-sticker);
    text-decoration: none;
  }
  .related-series-link:hover {
    text-decoration: underline;
  }

  .stat-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 16px 24px 0;
  }
  .stat-card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sticker);
    padding: 16px;
    cursor: pointer;
    border: 2px solid transparent;
    text-align: left;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
  }
  .stat-card.is-active {
    border-color: var(--color-accent);
    background: var(--color-surface-pending);
